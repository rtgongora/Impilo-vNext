# =============================================================================
# Impilo vNext — Server Environment Variables (TEMPLATE)
# Copy to .env.server and fill in real values for your environment.
# NEVER commit .env.server — it is in .gitignore.
# =============================================================================

# ----- PostgreSQL -----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=impilo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=impilo

# ----- Redis -----
REDIS_HOST=redis
REDIS_PORT=6379

# ----- Kafka -----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ----- Keycloak -----
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=impilo
KEYCLOAK_CLIENT_ID=impilo-ui
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ----- MinIO (S3-compatible) -----
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=impilo-docs

# ----- HAPI FHIR (BUTANO) -----
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir

# ----- Orthanc (PACS) -----
ORTHANC_URL=http://orthanc:8042

# ----- TSHEPO -----
TSHEPO_URL=http://tshepo:8081
TSHEPO_PEPPER=CHANGE_ME

# ----- Envoy Gateway -----
ENVOY_ADMIN_PORT=9901

# ----- Observability -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
