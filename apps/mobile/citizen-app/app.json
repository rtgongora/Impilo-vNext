{
  "expo": {
    "name": "Impilo Health",
    "slug": "impilo-citizen",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "impilo-citizen",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#009739"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "zw.gov.impilo.citizen",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for telehealth video consultations and to scan QR codes for health records.",
        "NSPhotoLibraryUsageDescription": "Used to upload profile photos and documents.",
        "NSFaceIDUsageDescription": "Used for biometric authentication.",
        "NSMicrophoneUsageDescription": "Used for telehealth video consultations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#009739"
      },
      "package": "zw.gov.impilo.citizen",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-video",
      "expo-web-browser",
      "expo-secure-store",
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Used for telehealth video consultations and to scan QR codes for health records.",
          "microphonePermission": "Used for telehealth audio and video consultations."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "impilo-citizen"
      }
    }
  }
}
