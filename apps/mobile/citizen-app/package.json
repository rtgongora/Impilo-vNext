{
  "name": "@impilo/citizen-app",
  "version": "0.1.0",
  "private": true,
  "description": "Impilo Citizen App — Personal health, social feed, marketplace, messaging, and telehealth for citizens/patients. Targets Android and iOS via Expo.",
  "main": "src/main.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild": "expo prebuild",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@impilo/mobile-trust": "workspace:*",
    "@impilo/mobile-auth": "workspace:*",
    "@impilo/mobile-api-client": "workspace:*",
    "@impilo/mobile-messaging": "workspace:*",
    "@impilo/mobile-timeline": "workspace:*",
    "@impilo/mobile-offline": "workspace:*",
    "@impilo/mobile-design-system": "workspace:*",
    "@tanstack/react-query": "^5.83.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "~52.0.0",
    "expo-auth-session": "~6.0.0",
    "expo-build-properties": "~0.13.0",
    "expo-constants": "~17.0.0",
    "expo-crypto": "~14.0.0",
    "expo-linking": "~7.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-splash-screen": "~0.29.0",
    "expo-status-bar": "~2.0.0",
    "expo-web-browser": "~14.0.0",
    "react": "^18.3.1",
    "react-native": "~0.76.0",
    "react-native-safe-area-context": "~4.12.0",
    "react-native-screens": "~4.1.0",
    "@react-native-community/netinfo": "~11.4.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "^18.3.11",
    "babel-preset-expo": "~12.0.0",
    "jsdom": "^24.1.3",
    "typescript": "~5.5.4",
    "vitest": "^2.1.0",
    "@testing-library/react-native": "^12.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
