{
  "name": "@impilo/provider-app",
  "version": "0.1.0",
  "private": true,
  "description": "Impilo Provider App — clinical workflows for Provider, Outreach, Supervisor, and Offline Edge modes. Targets Android and iOS via Expo.",
  "main": "src/main.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild": "expo prebuild",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@impilo/mobile-api-client": "workspace:*",
    "@impilo/mobile-auth": "workspace:*",
    "@impilo/mobile-design-system": "workspace:*",
    "@impilo/mobile-integration": "workspace:*",
    "@impilo/mobile-messaging": "workspace:*",
    "@impilo/mobile-ndila": "workspace:*",
    "@impilo/mobile-nompilo": "workspace:*",
    "@impilo/mobile-offline": "workspace:*",
    "@impilo/mobile-timeline": "workspace:*",
    "@impilo/mobile-trust": "workspace:*",
    "@react-native-community/netinfo": "~11.4.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.83.0",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-linking": "~8.0.12",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^12.5.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.5",
    "babel-preset-expo": "~54.0.10",
    "react-dom": "19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
