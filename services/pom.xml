<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.6</version>
        <relativePath/>
    </parent>

    <groupId>zw.gov.mohcc.impilo</groupId>
    <artifactId>impilo-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Impilo vNext — Parent POM</name>
    <description>
        Shared dependency management and build configuration for all Impilo platform services.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency versions (single source of truth) -->
        <spring-boot.version>3.3.6</spring-boot.version>
        <spring-kafka.version>3.2.4</spring-kafka.version>
        <hapi-fhir.version>7.4.0</hapi-fhir.version>
        <flyway.version>10.17.3</flyway.version>
        <postgresql.version>42.7.4</postgresql.version>
        <redis.version>3.3.6</redis.version>
        <minio.version>8.5.12</minio.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
        <opentelemetry.version>1.41.0</opentelemetry.version>
        <mapstruct.version>1.6.2</mapstruct.version>
        <springdoc.version>2.6.0</springdoc.version>
        <nimbus-jose.version>9.40</nimbus-jose.version>
        <grpc.version>1.65.1</grpc.version>
        <grpc-spring-boot.version>3.1.0.RELEASE</grpc-spring-boot.version>
        <protobuf.version>3.25.3</protobuf.version>
    </properties>

    <modules>
        <module>shared-core</module>
        <module>tshepo-service</module>
        <module>vito-service</module>
        <module>varapi-service</module>
        <module>tuso-service</module>
        <module>zibo-service</module>
        <module>msika-service</module>
        <module>ubomi-service</module>
        <module>fhir-gateway-service</module>
        <module>pct-service</module>
        <module>oros-service</module>
        <module>pharmacy-service</module>
        <module>pharmacy-elmis-adapter</module>
        <module>inpatient-service</module>
        <module>inventory-service</module>
        <module>inventory-elmis-adapter</module>
        <module>mushex-service</module>
        <module>costing-engine-service</module>
        <module>document-service</module>
        <module>pacs-adapter-service</module>
        <module>notification-service</module>
        <module>jobs-service</module>
        <module>integration-hub</module>
        <module>rules-service</module>
        <module>offline-sync-service</module>
        <module>card-print-agent</module>
        <!-- Landela-Integrated Credential & Document Suite -->
        <module>landela-adapter-service</module>
        <module>credential-verification-service</module>
        <module>share-slip-service</module>
        <!-- MSIKA Flow — Health Marketplace Orchestration -->
        <module>msika-flow-service</module>
        <!-- BUTANO — Shared Health Record (HAPI FHIR JPA) -->
        <module>butano-service</module>
        <!-- Search Service — Enterprise Search -->
        <module>search-service</module>
        <!-- Forms Service — Clinical Content Platform -->
        <module>forms-service</module>
        <!-- Data Pipeline — v1.1-Native Ingestion & Watermarking -->
        <module>data-pipeline-service</module>
        <!-- NDR — National Data Repository (v1.1-Native Analytics Store) -->
        <module>national-data-repository-service</module>
        <!-- Reporting — Platform Analytics & Report Generation (v1.1-Native) -->
        <module>reporting-service</module>
        <!-- DAGS — Data Access Governance Service (v1.1-Native) -->
        <module>data-access-governance-service</module>
        <!-- Surveillance — Public Health Event Monitoring (v1.1-Native) -->
        <module>surveillance-service</module>
        <!-- Campaigns — Public Health Campaign Management (v1.1-Native) -->
        <module>campaigns-service</module>
        <!-- Identity Assurance — Device Attestation & Risk Scoring (v1.1-Native) -->
        <module>identity-assurance-service</module>
        <!-- Observability — Dashboard & Alert Rule Registry (v1.1-Native Stub) -->
        <module>observability-service</module>
        <!-- Security Hardening — Policy Pack & Compliance Scan Registry (v1.1-Native Stub) -->
        <module>security-hardening-service</module>
        <!-- Channels — Omnichannel Access Gateway (v1.1-Native) -->
        <module>channels-service</module>
        <!-- Coverage — Coverage & Eligibility Engine (v1.1-Native) -->
        <module>coverage-service</module>
        <!-- INDAWO — Location & Address Registry (v1.1-Native) -->
        <module>indawo-service</module>
        <!-- TSHEPO decomposition (6 sub-services) -->
        <module>tshepo-authz-service</module>
        <module>tshepo-identity-service</module>
        <module>tshepo-consent-service</module>
        <module>tshepo-audit-service</module>
        <module>tshepo-keys-service</module>
        <module>tshepo-offline-service</module>
        <!-- TSHEPO shared libraries (under libs/) -->
        <module>../libs/tshepo-contracts</module>
        <module>../libs/tshepo-sdk</module>
        <!-- Tech Companion Suite (v1.1 enforcement primitives) -->
        <module>../libs/tech-companion</module>
        <module>../libs/federation-connector</module>
        <module>../libs/tech-companion-harness</module>
        <module>../libs/tech-companion-mock</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM (imported from parent, listed here for clarity) -->

            <!-- Kafka -->
            <dependency>
                <groupId>org.springframework.kafka</groupId>
                <artifactId>spring-kafka</artifactId>
                <version>${spring-kafka.version}</version>
            </dependency>

            <!-- HAPI FHIR -->
            <dependency>
                <groupId>ca.uhn.hapi.fhir</groupId>
                <artifactId>hapi-fhir-base</artifactId>
                <version>${hapi-fhir.version}</version>
            </dependency>
            <dependency>
                <groupId>ca.uhn.hapi.fhir</groupId>
                <artifactId>hapi-fhir-structures-r4</artifactId>
                <version>${hapi-fhir.version}</version>
            </dependency>
            <dependency>
                <groupId>ca.uhn.hapi.fhir</groupId>
                <artifactId>hapi-fhir-client</artifactId>
                <version>${hapi-fhir.version}</version>
            </dependency>

            <!-- Database -->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <!-- MinIO -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- OpenAPI docs -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Cryptography (Argon2id via Bouncy Castle — required by Spring Security) -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- Nimbus JOSE (JWT/JWS/JWK) -->
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose.version}</version>
            </dependency>

            <!-- gRPC -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-netty-shaded</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-protobuf</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-stub</artifactId>
                <version>${grpc.version}</version>
            </dependency>
            <dependency>
                <groupId>net.devh</groupId>
                <artifactId>grpc-server-spring-boot-starter</artifactId>
                <version>${grpc-spring-boot.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- TSHEPO shared libraries -->
            <dependency>
                <groupId>zw.gov.mohcc.impilo</groupId>
                <artifactId>tshepo-contracts</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>zw.gov.mohcc.impilo</groupId>
                <artifactId>tshepo-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Observability -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>

            <!-- Tech Companion Suite -->
            <dependency>
                <groupId>zw.gov.mohcc.impilo</groupId>
                <artifactId>tech-companion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>zw.gov.mohcc.impilo</groupId>
                <artifactId>federation-connector</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>zw.gov.mohcc.impilo</groupId>
                <artifactId>tech-companion-harness</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
