  "encounterContexts": ["inpatient"],
  "requiredWorkflow": "ADMIT",
  "obligationDefault": "MANDATORY",
  "permittedCadres": ["PHYSICIAN", "CLINICAL_OFFICER"],
  "minAgeMonths": 156,
