  "definition": {
    "id": "impilo.anc.contact1.v1",
    "version": "2.0.0",
    "title": "Antenatal Care — First Contact",
    "description": "WHO ANC-aligned first contact. Captures what opening a pregnancy episode requires: a dating basis with its certainty, and blood pressure as two numbers rather than a sentence.",
    "dakReference": "WHO ANC DAK",
    "healthDomain": "MATERNAL",
    "programme": "ANC",
    "encounterTypes": [
      "ANTENATAL",
      "ANC",
      "MATERNITY",
      "OBSTETRICS"
    ],
    "minAgeMonths": 120,
    "sexApplicability": [
      "FEMALE"
    ],
    "providerRoles": [
      "MIDWIFE",
      "NURSE",
      "DOCTOR",
      "CLINICAL_OFFICER"
    ],
    "offlineCapable": true,
    "audit": {
      "dataCustodian": "MOHCC",
      "sensitivity": "SENSITIVE"
    },
    "sections": [
      {
        "id": "history",
        "title": "Dating and obstetric history",
        "fields": [
          {
            "id": "lmp",
            "linkId": "lmp",
            "label": "Last menstrual period",
            "kind": "date",
            "validation": {
              "required": false
            },
            "description": "Leave blank if she does not know it. A guessed date produces a confident gestational age that is wrong, which is worse than an absent one."
          },
          {
            "id": "lmpCertainty",
            "linkId": "lmpCertainty",
            "label": "How sure is she of that date?",
            "kind": "coded_single",
            "description": "Decides whether a later scan may redate the pregnancy. An uncertain date is not a worse date, it is a different kind of evidence.",
            "options": [
              {
                "code": "CERTAIN",
                "display": "Certain, cycles regular"
              },
              {
                "code": "UNCERTAIN",
                "display": "Uncertain, or cycles irregular"
              },
              {
                "code": "UNKNOWN",
                "display": "She does not know"
              }
            ],
            "validation": {
              "required": false
            }
          },
          {
            "id": "datingUltrasoundDate",
            "linkId": "datingUltrasoundDate",
            "label": "Dating ultrasound date",
            "kind": "date",
            "validation": {
              "required": false
            }
          },
          {
            "id": "datingUltrasoundGaDays",
            "linkId": "datingUltrasoundGaDays",
            "label": "Gestational age measured on that scan",
            "kind": "numeric_with_unit",
            "unit": "days",
            "description": "In completed days. The scan's own measurement, not the gestation implied by the last menstrual period.",
            "validation": {
              "min": 0,
              "max": 300,
              "required": false
            }
          },
          {
            "id": "gravida",
            "linkId": "gravida",
            "label": "Gravida",
            "kind": "numeric_with_unit",
            "unit": "count",
            "validation": {
              "min": 0,
              "max": 20,
              "required": false
            },
            "description": "As she reports it. The record derives its own count from previous pregnancies and flags a disagreement rather than overwriting hers."
          },
          {
            "id": "parity",
            "linkId": "parity",
            "label": "Parity",
            "kind": "numeric_with_unit",
            "unit": "count",
            "validation": {
              "min": 0,
              "max": 20,
              "required": false
            },
            "description": "Pregnancies carried to viability, not babies delivered. Twins are 1."
          }
        ]
      },
      {
        "id": "exam",
        "title": "Examination & screening",
        "fields": [
          {
            "id": "systolicBp",
            "linkId": "systolicBp",
            "label": "Systolic blood pressure",
            "kind": "numeric_with_unit",
            "unit": "mmHg",
            "description": "Hypertensive disease is the condition antenatal care most exists to catch. A threshold cannot be applied to a sentence.",
            "validation": {
              "min": 40,
              "max": 300,
              "required": true
            }
          },
          {
            "id": "diastolicBp",
            "linkId": "diastolicBp",
            "label": "Diastolic blood pressure",
            "kind": "numeric_with_unit",
            "unit": "mmHg",
            "validation": {
              "min": 20,
              "max": 200,
              "required": true
            }
          },
          {
            "id": "fundalHeight",
            "linkId": "fundalHeight",
            "label": "Fundal height",
            "kind": "numeric_with_unit",
            "unit": "cm",
            "validation": {
              "min": 0,
              "max": 50
            }
          },
          {
            "id": "hivStatus",
            "linkId": "hivStatus",
            "label": "HIV status",
            "kind": "coded_single",
            "options": [
              {
                "code": "NEG",
                "display": "Negative"
              },
              {
                "code": "POS",
                "display": "Positive"
              },
              {
                "code": "UNKNOWN",
                "display": "Unknown / declined"
              }
            ]
          }
        ]
      },
      {
        "id": "plan",
        "title": "Counselling & plan",
        "fields": [
          {
            "id": "counselling",
            "linkId": "counselling",
            "label": "Counselling provided",
            "kind": "coded_multi",
            "options": [
              {
                "code": "NUTRITION",
                "display": "Nutrition"
              },
              {
                "code": "DANGER_SIGNS",
                "display": "Danger signs"
              },
              {
                "code": "BIRTH_PLAN",
                "display": "Birth plan"
              },
              {
                "code": "PMTCT",
                "display": "PMTCT"
              }
            ]
          },
          {
            "id": "referralDecision",
            "linkId": "referralDecision",
            "label": "Referral decision",
            "kind": "coded_single",
            "options": [
              {
                "code": "NONE",
                "display": "Continue routine ANC"
              },
              {
                "code": "REFER",
                "display": "Refer"
              }
            ]
          }
        ]
      }
    ]
  }
}
