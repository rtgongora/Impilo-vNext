  "definition": {
    "id": "impilo.anc.contact1.v1",
    "version": "1.0.0",
    "title": "Antenatal Care — First Contact",
    "description": "WHO ANC-aligned exemplar.",
    "dakReference": "WHO ANC DAK",
    "healthDomain": "MATERNAL",
    "programme": "ANC",
    "encounterTypes": ["ANTENATAL", "ANC", "MATERNITY", "OBSTETRICS"],
    "minAgeMonths": 120,
    "sexApplicability": ["FEMALE"],
    "providerRoles": ["MIDWIFE", "NURSE", "DOCTOR", "CLINICAL_OFFICER"],
    "offlineCapable": true,
    "audit": {"dataCustodian": "MOHCC", "sensitivity": "SENSITIVE"},
    "sections": [
      {
        "id": "history",
        "title": "Obstetric history",
        "fields": [
          {"id": "lmp", "linkId": "lmp", "label": "Last menstrual period", "kind": "date", "validation": {"required": true}},
          {"id": "gravida", "linkId": "gravida", "label": "Gravida", "kind": "numeric_with_unit", "unit": "count", "validation": {"min": 0, "max": 20, "required": true}},
          {"id": "parity", "linkId": "parity", "label": "Parity", "kind": "numeric_with_unit", "unit": "count", "validation": {"min": 0, "max": 20, "required": true}}
        ]
      },
      {
        "id": "exam",
        "title": "Examination & screening",
        "fields": [
          {"id": "bp", "linkId": "bp", "label": "Blood pressure", "kind": "text", "validation": {"required": true}},
          {"id": "fundalHeight", "linkId": "fundalHeight", "label": "Fundal height", "kind": "numeric_with_unit", "unit": "cm", "validation": {"min": 0, "max": 50}},
          {"id": "hivStatus", "linkId": "hivStatus", "label": "HIV status", "kind": "coded_single", "options": [{"code": "NEG", "display": "Negative"}, {"code": "POS", "display": "Positive"}, {"code": "UNKNOWN", "display": "Unknown / declined"}]}
        ]
      },
      {
        "id": "plan",
        "title": "Counselling & plan",
        "fields": [
          {"id": "counselling", "linkId": "counselling", "label": "Counselling provided", "kind": "coded_multi", "options": [
            {"code": "NUTRITION", "display": "Nutrition"},
            {"code": "DANGER_SIGNS", "display": "Danger signs"},
            {"code": "BIRTH_PLAN", "display": "Birth plan"},
            {"code": "PMTCT", "display": "PMTCT"}
          ]},
          {"id": "referralDecision", "linkId": "referralDecision", "label": "Referral decision", "kind": "coded_single", "options": [{"code": "NONE", "display": "Continue routine ANC"}, {"code": "REFER", "display": "Refer"}]}
        ]
      }
    ]
  }
