<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zw.gov.mohcc.impilo</groupId>
        <artifactId>impilo-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tshepo-keys-service</artifactId>
    <name>TSHEPO Keys — Service-to-Service Trust &amp; Key Management</name>
    <description>
        Ed25519 signing key management, JWKS distribution, key rotation,
        mTLS certificate trust, referral package signing, and JWS token issuance
        for the Impilo platform (TSHEPO sub-domain 3.7).
    </description>

    <properties>
        <nimbus-jose-jwt.version>9.40</nimbus-jose-jwt.version>
        <!-- Runtime-proof datasource (SigningRuntimeProofIT). Empty by default ⇒ the IT
             self-skips; override with -Dit.pg.url=... -Dit.pg.user=... -Dit.pg.pass=... -->
        <it.pg.url/>
        <it.pg.user/>
        <it.pg.pass/>
    </properties>

    <dependencies>
        <!-- TSHEPO Contracts (shared DTOs, headers, enums) -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>tshepo-contracts</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Shared Core (trust context, API envelope, crypto utilities) -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>shared-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Security (OAuth2 Resource Server for OIDC token validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Data -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Redis (JWKS cache, key metadata cache) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Cryptography — Bouncy Castle (Ed25519 key generation, AES-GCM) -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Nimbus JOSE+JWT (JWS compact serialization, JWKS) -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>

        <!-- Tink — Nimbus Ed25519Signer / Ed25519Verifier load Tink's subtle Ed25519 at runtime -->
        <dependency>
            <groupId>com.google.crypto.tink</groupId>
            <artifactId>tink</artifactId>
            <version>1.14.1</version>
        </dependency>

        <!-- Observability -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- OpenAPI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- spring-security-test: jwt() request post-processor for the /v1/sign runtime proof. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Tech Companion — v1.1 auto-configuration -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>tech-companion</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Tech Companion Harness — golden contract tests -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>tech-companion-harness</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Forward the runtime-proof datasource into the Surefire fork. SigningRuntimeProofIT
                 runs against a real Postgres provided by the harness; with it.pg.url empty it
                 self-skips via @EnabledIfSystemProperty, leaving the mocked unit suite unaffected. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <it.pg.url>${it.pg.url}</it.pg.url>
                        <it.pg.user>${it.pg.user}</it.pg.user>
                        <it.pg.pass>${it.pg.pass}</it.pg.pass>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Runtime-proof integration tests (real PostgreSQL via -Dit.pg.url). Opt-in: mvn verify -Pit-runtime-proof -Dit.pg.url=... . Self-skips without it.pg.url. -->
        <profile>
            <id>it-runtime-proof</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/SigningRuntimeProofIT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
