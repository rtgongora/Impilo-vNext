      "expectAdmissionCriterion": "MUAC_11_5_TO_12_4"
    },
    {
      "kind": "ELIGIBILITY",
      "name": "MUAC 13.5 with no oedema is not eligible for a nutrition programme",
      "facts": {"ageDays": 400, "muacCm": 13.5, "bilateralPittingOedema": "ABSENT"},
      "expectEligible": false,
      "expectAssessable": true
    },
    {
      "kind": "ELIGIBILITY",
      "name": "a child never measured is not reported as ineligible",
      "facts": {"ageDays": 400},
      "expectEligible": false,
      "expectAssessable": false
    },
    {
      "kind": "ELIGIBILITY",
      "name": "an IMNCI classification routes without re-deriving the anthropometry",
      "facts": {"ageDays": 400, "classification": "UNCOMPLICATED_SEVERE_ACUTE_MALNUTRITION"},
      "expectEligible": true,
      "expectProgramme": "OTP",
      "expectAdmissionCriterion": "IMNCI_CLASSIFICATION"
    },
    {
      "kind": "ELIGIBILITY",
      "name": "MUAC is not interpretable under six months and does not admit on its own",
      "facts": {"ageDays": 90, "muacCm": 10.0, "bilateralPittingOedema": "ABSENT"},
      "expectEligible": false,
      "expectAssessable": false
    },

