{
  "packId": "impilo.paediatric.imnci-classification",
  "version": "engineering-seed-1.0.0",
  "approvalStatus": "ENGINEERING_SEED",
  "adaptationAuthority": "PENDING_MOHCC_RATIFICATION",
  "provenance": "Assess-and-classify tables follow the WHO/UNICEF Integrated Management of Newborn and Childhood Illness chart booklet for the sick child aged 2 months up to 5 years. Malaria classification requires parasitological confirmation in line with WHO policy and Zimbabwe's focal transmission; presumptive treatment on fever alone is deliberately not implemented. Thresholds, wording and treatment lines are an engineering seed and are NOT a ratified national protocol. They require MoHCC and paediatric specialist sign-off before they drive care. See docs/clinical-governance/edliz-engineering-seed-policy.md.",
  "tables": [

    {
      "tableId": "IMNCI_PNEUMONIA",
      "name": "Cough or difficult breathing",
      "axis": "Pneumonia severity",
      "ageMinDays": 60,
      "ageMaxDays": 1824,
      "appliesWhen": {
        "any": [
          {"finding": "cough", "present": true},
          {"finding": "difficultBreathing", "present": true}
        ]
      },
      "requiredInputs": ["chestIndrawing", "stridorAtRest", "vitals.respiratoryRate"],
      "sourceRefs": ["WHO IMNCI chart booklet — cough or difficult breathing"],
      "tiers": [
        {
          "code": "SEVERE_PNEUMONIA_OR_VERY_SEVERE_DISEASE",
          "name": "Severe pneumonia or very severe disease",
          "colour": "PINK",
          "logic": {
            "any": [
              {"finding": "unableToDrinkOrBreastfeed", "present": true},
              {"finding": "vomitsEverything", "present": true},
              {"finding": "convulsions", "present": true},
              {"finding": "lethargicOrUnconscious", "present": true},
              {"finding": "chestIndrawing", "present": true},
              {"finding": "stridorAtRest", "present": true}
            ]
          },
          "action": "Give the first dose of an appropriate antibiotic, treat wheeze if present, keep the child warm, and refer urgently to hospital.",
          "treatments": ["First dose of injectable or oral antibiotic per EDLIZ", "Oxygen if saturation below 90%", "Urgent referral"],
          "referralRequired": true,
          "urgentReferral": true
        },
        {
          "code": "PNEUMONIA",
          "name": "Pneumonia",
          "colour": "YELLOW",
          "logic": {
            "any": [
              {"all": [
                {"input": "ageDays", "op": "between", "min": 60, "max": 364},
                {"input": "vitals.respiratoryRate", "op": "gte", "value": 50}
              ]},
              {"all": [
                {"input": "ageDays", "op": "between", "min": 365, "max": 1824},
                {"input": "vitals.respiratoryRate", "op": "gte", "value": 40}
              ]}
            ]
          },
          "action": "Treat with oral antibiotic at this facility, advise the carer on when to return immediately, and review in 3 days.",
          "treatments": ["Oral amoxicillin per EDLIZ paediatric dosing", "Soothe the throat and relieve cough with a safe remedy", "Follow-up in 3 days"],
          "referralRequired": false,
          "urgentReferral": false
        },
        {
          "code": "COUGH_OR_COLD",
          "name": "Cough or cold",
          "colour": "GREEN",
          "logic": null,
          "action": "No antibiotic. Advise home care, soothe the throat, and teach the carer the signs that mean return immediately.",
          "treatments": ["Home care advice", "Safe remedy for cough", "Return immediately if breathing becomes difficult or fast"],
          "referralRequired": false,
          "urgentReferral": false
        }
      ],
      "testCases": [
        {"name": "chest indrawing is severe pneumonia", "facts": {"ageDays": 420, "cough": "PRESENT", "chestIndrawing": "PRESENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "SEVERE_PNEUMONIA_OR_VERY_SEVERE_DISEASE"},
        {"name": "fast breathing at 14 months is pneumonia", "facts": {"ageDays": 420, "cough": "PRESENT", "unableToDrinkOrBreastfeed": "ABSENT", "vomitsEverything": "ABSENT", "convulsions": "ABSENT", "lethargicOrUnconscious": "ABSENT", "chestIndrawing": "ABSENT", "stridorAtRest": "ABSENT", "vitals": {"respiratoryRate": 46}}, "expectStatus": "CLASSIFIED", "expectClassification": "PNEUMONIA"},
        {"name": "46 breaths at 6 months is also pneumonia only below the infant threshold", "facts": {"ageDays": 180, "cough": "PRESENT", "unableToDrinkOrBreastfeed": "ABSENT", "vomitsEverything": "ABSENT", "convulsions": "ABSENT", "lethargicOrUnconscious": "ABSENT", "chestIndrawing": "ABSENT", "stridorAtRest": "ABSENT", "vitals": {"respiratoryRate": 46}}, "expectStatus": "CLASSIFIED", "expectClassification": "COUGH_OR_COLD"},
        {"name": "no cough means the table does not apply", "facts": {"ageDays": 420, "cough": "ABSENT", "difficultBreathing": "ABSENT"}, "expectStatus": "NOT_APPLICABLE"},
        {"name": "unexamined chest cannot be classified as a cold", "facts": {"ageDays": 420, "cough": "PRESENT", "vitals": {"respiratoryRate": 30}}, "expectStatus": "INDETERMINATE"}
      ]
    },

    {
      "tableId": "IMNCI_DEHYDRATION",
      "name": "Diarrhoea — dehydration",
      "axis": "Dehydration status",
      "ageMinDays": 60,
      "ageMaxDays": 1824,
      "appliesWhen": {"finding": "diarrhoea", "present": true},
      "requiredInputs": ["lethargicOrUnconscious", "sunkenEyes", "drinkingPattern", "skinPinch"],
      "sourceRefs": ["WHO IMNCI chart booklet — diarrhoea, classify dehydration"],
      "tiers": [
        {
          "code": "SEVERE_DEHYDRATION",
          "name": "Severe dehydration",
          "colour": "PINK",
          "logic": {
            "atLeast": 2,
            "of": [
              {"finding": "lethargicOrUnconscious", "present": true},
              {"finding": "sunkenEyes", "present": true},
              {"input": "drinkingPattern", "op": "eq", "value": "NOT_ABLE_TO_DRINK_OR_DRINKING_POORLY"},
              {"input": "skinPinch", "op": "eq", "value": "VERY_SLOW"}
            ]
          },
          "action": "Start Plan C now — intravenous fluid if you can give it, and refer urgently. Give ORS by mouth on the way if the child can drink.",
          "treatments": ["Plan C intravenous rehydration", "Urgent referral", "ORS during transfer if able to drink"],
          "referralRequired": true,
          "urgentReferral": true
        },
        {
          "code": "SOME_DEHYDRATION",
          "name": "Some dehydration",
          "colour": "YELLOW",
          "logic": {
            "atLeast": 2,
            "of": [
              {"finding": "restlessIrritable", "present": true},
              {"finding": "sunkenEyes", "present": true},
              {"input": "drinkingPattern", "op": "eq", "value": "DRINKS_EAGERLY_THIRSTY"},
              {"input": "skinPinch", "op": "eq", "value": "SLOW"}
            ]
          },
          "action": "Give ORS at this facility under observation for 4 hours (Plan B), continue feeding, and reassess.",
          "treatments": ["Plan B — ORS in the clinic for 4 hours", "Continue breastfeeding", "Zinc for 14 days", "Review in 5 days if not improving"],
          "referralRequired": false,
          "urgentReferral": false
        },
        {
          "code": "NO_DEHYDRATION",
          "name": "No dehydration",
          "colour": "GREEN",
          "logic": null,
          "action": "Treat at home with extra fluid, zinc and continued feeding (Plan A), and teach the return signs.",
          "treatments": ["Plan A — extra fluid at home", "Zinc for 14 days", "Continue feeding", "Return immediately if drinking poorly or blood in the stool"],
          "referralRequired": false,
          "urgentReferral": false
        }
      ],
      "testCases": [
        {"name": "sunken eyes with a very slow skin pinch is severe", "facts": {"ageDays": 400, "diarrhoea": "PRESENT", "sunkenEyes": "PRESENT", "skinPinch": "VERY_SLOW"}, "expectStatus": "CLASSIFIED", "expectClassification": "SEVERE_DEHYDRATION"},
        {"name": "one severe sign alone is not severe dehydration", "facts": {"ageDays": 400, "diarrhoea": "PRESENT", "lethargicOrUnconscious": "ABSENT", "sunkenEyes": "PRESENT", "drinkingPattern": "DRINKS_NORMALLY", "skinPinch": "NORMAL", "restlessIrritable": "ABSENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "NO_DEHYDRATION"},
        {"name": "thirsty with sunken eyes is some dehydration", "facts": {"ageDays": 400, "diarrhoea": "PRESENT", "lethargicOrUnconscious": "ABSENT", "sunkenEyes": "PRESENT", "drinkingPattern": "DRINKS_EAGERLY_THIRSTY", "skinPinch": "NORMAL", "restlessIrritable": "ABSENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "SOME_DEHYDRATION"},
        {"name": "one sign present and the rest unexamined cannot be called no dehydration", "facts": {"ageDays": 400, "diarrhoea": "PRESENT", "sunkenEyes": "PRESENT"}, "expectStatus": "INDETERMINATE"}
      ]
    },

    {
      "tableId": "IMNCI_PERSISTENT_DIARRHOEA",
      "name": "Diarrhoea — persistence",
      "axis": "Diarrhoea duration",
      "ageMinDays": 60,
      "ageMaxDays": 1824,
      "appliesWhen": {
        "all": [
          {"finding": "diarrhoea", "present": true},
          {"input": "diarrhoeaDurationDays", "op": "gte", "value": 14}
        ]
      },
      "requiredInputs": ["diarrhoeaDurationDays", "sunkenEyes", "skinPinch"],
      "sourceRefs": ["WHO IMNCI chart booklet — persistent diarrhoea"],
      "tiers": [
        {
          "code": "SEVERE_PERSISTENT_DIARRHOEA",
          "name": "Severe persistent diarrhoea",
          "colour": "PINK",
          "logic": {
            "atLeast": 2,
            "of": [
              {"finding": "lethargicOrUnconscious", "present": true},
              {"finding": "sunkenEyes", "present": true},
              {"input": "drinkingPattern", "op": "eq", "value": "NOT_ABLE_TO_DRINK_OR_DRINKING_POORLY"},
              {"input": "skinPinch", "op": "eq", "value": "VERY_SLOW"},
              {"finding": "restlessIrritable", "present": true},
              {"input": "drinkingPattern", "op": "eq", "value": "DRINKS_EAGERLY_THIRSTY"},
              {"input": "skinPinch", "op": "eq", "value": "SLOW"}
            ]
          },
          "action": "Treat the dehydration before referral unless the child also has severe acute malnutrition, then refer.",
          "treatments": ["Rehydrate before transfer", "Referral to hospital"],
          "referralRequired": true,
          "urgentReferral": false
        },
        {
          "code": "PERSISTENT_DIARRHOEA",
          "name": "Persistent diarrhoea",
          "colour": "YELLOW",
          "logic": null,
          "action": "Advise on feeding for persistent diarrhoea, give multivitamins and minerals including zinc for 14 days, and review in 5 days.",
          "treatments": ["Feeding advice for persistent diarrhoea", "Zinc and micronutrients for 14 days", "Follow-up in 5 days"],
          "referralRequired": false,
          "urgentReferral": false
        }
      ],
      "testCases": [
        {"name": "three days of diarrhoea is not persistent", "facts": {"ageDays": 400, "diarrhoea": "PRESENT", "diarrhoeaDurationDays": 3}, "expectStatus": "NOT_APPLICABLE"},
        {"name": "twenty days without dehydration is persistent diarrhoea", "facts": {"ageDays": 400, "diarrhoea": "PRESENT", "diarrhoeaDurationDays": 20, "lethargicOrUnconscious": "ABSENT", "sunkenEyes": "ABSENT", "drinkingPattern": "DRINKS_NORMALLY", "skinPinch": "NORMAL", "restlessIrritable": "ABSENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "PERSISTENT_DIARRHOEA"},
        {"name": "duration never recorded leaves the table unassessed", "facts": {"ageDays": 400, "diarrhoea": "PRESENT"}, "expectStatus": "NOT_ASSESSED"}
      ]
    },

    {
      "tableId": "IMNCI_DYSENTERY",
      "name": "Diarrhoea — blood in the stool",
