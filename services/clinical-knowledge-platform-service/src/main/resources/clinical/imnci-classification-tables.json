          "action": "Treat for shigella with an oral antibiotic per EDLIZ and review in 3 days.",
          "treatments": ["Ciprofloxacin per EDLIZ paediatric dosing", "Zinc for 14 days", "Follow-up in 3 days"],
          "referralRequired": false,
          "urgentReferral": false
        },
        {
          "code": "NO_DYSENTERY",
          "name": "No dysentery",
          "colour": "GREEN",
