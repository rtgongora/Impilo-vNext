          "referralRequired": false,
          "urgentReferral": false
        },
        {
          "code": "NO_EAR_INFECTION",
          "name": "No ear infection",
          "colour": "GREEN",
          "logic": null,
          "action": "No additional treatment for the ear.",
          "treatments": [],
          "referralRequired": false,
          "urgentReferral": false
        }
      ],
      "testCases": [
        {"name": "tender swelling behind the ear is mastoiditis", "facts": {"ageDays": 400, "earProblem": "PRESENT", "tenderSwellingBehindEar": "PRESENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "MASTOIDITIS"},
        {"name": "three weeks of discharge is chronic", "facts": {"ageDays": 400, "earProblem": "PRESENT", "tenderSwellingBehindEar": "ABSENT", "earDischarge": "PRESENT", "earDischargeDurationDays": 21, "earPain": "ABSENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "CHRONIC_EAR_INFECTION"},
        {"name": "ear pain alone is an acute infection", "facts": {"ageDays": 400, "earProblem": "PRESENT", "tenderSwellingBehindEar": "ABSENT", "earDischarge": "ABSENT", "earPain": "PRESENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "ACUTE_EAR_INFECTION"}
      ]
    },

    {
      "tableId": "IMNCI_ACUTE_MALNUTRITION",
      "name": "Acute malnutrition",
      "axis": "Nutritional status",
      "ageMinDays": 60,
      "ageMaxDays": 1824,
      "appliesWhen": null,
      "requiredInputs": ["muacCm", "bilateralPittingOedema", "appetiteTest"],
      "sourceRefs": [
        "WHO IMNCI chart booklet — malnutrition",
        "WHO/UNICEF community-based management of severe acute malnutrition"
      ],
      "tiers": [
        {
          "code": "COMPLICATED_SEVERE_ACUTE_MALNUTRITION",
          "name": "Complicated severe acute malnutrition",
          "colour": "PINK",
          "logic": {
