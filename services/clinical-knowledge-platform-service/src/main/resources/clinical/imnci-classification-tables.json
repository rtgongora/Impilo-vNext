          "action": "No antibiotic for dysentery.",
          "treatments": [],
          "referralRequired": false,
          "urgentReferral": false
        }
      ],
      "testCases": [
        {"name": "blood in the stool is dysentery", "facts": {"ageDays": 400, "diarrhoea": "PRESENT", "bloodInStool": "PRESENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "DYSENTERY"},
        {"name": "stool never asked about cannot be called no dysentery", "facts": {"ageDays": 400, "diarrhoea": "PRESENT"}, "expectStatus": "INDETERMINATE"}
      ]
    },

    {
      "tableId": "IMNCI_FEVER_MALARIA",
      "name": "Fever",
      "axis": "Febrile illness",
      "ageMinDays": 60,
      "ageMaxDays": 1824,
      "appliesWhen": {
        "any": [
          {"finding": "feverByHistory", "present": true},
          {"finding": "feelsHot", "present": true},
          {"input": "vitals.temperature", "op": "gte", "value": 37.5, "optionalCriterion": true}
        ]
      },
      "requiredInputs": ["stiffNeck", "malariaTestResult"],
      "sourceRefs": [
        "WHO IMNCI chart booklet — fever",
        "WHO Guidelines for malaria — parasitological confirmation before treatment"
      ],
      "tiers": [
        {
          "code": "VERY_SEVERE_FEBRILE_DISEASE",
          "name": "Very severe febrile disease",
          "colour": "PINK",
          "logic": {
            "any": [
              {"finding": "unableToDrinkOrBreastfeed", "present": true},
              {"finding": "vomitsEverything", "present": true},
              {"finding": "convulsions", "present": true},
              {"finding": "lethargicOrUnconscious", "present": true},
              {"finding": "stiffNeck", "present": true},
              {"finding": "bulgingFontanelle", "present": true}
            ]
          },
          "action": "Give the first dose of an antibiotic and of artesunate or quinine, treat hypoglycaemia, give paracetamol for high fever, and refer urgently.",
          "treatments": ["First dose of injectable antibiotic", "First dose of parenteral antimalarial", "Treat hypoglycaemia", "Urgent referral"],
          "referralRequired": true,
          "urgentReferral": true
        },
        {
          "code": "MALARIA",
          "name": "Malaria",
          "colour": "YELLOW",
          "logic": {"input": "malariaTestResult", "op": "eq", "value": "POSITIVE"},
          "action": "Treat with the first-line oral antimalarial per EDLIZ, give paracetamol for high fever, and review in 3 days if the fever persists.",
          "treatments": ["Artemether-lumefantrine per EDLIZ weight bands", "Paracetamol for fever above 38.5C", "Return in 3 days if fever persists"],
          "referralRequired": false,
          "urgentReferral": false
        },
        {
          "code": "FEVER_NO_MALARIA",
          "name": "Fever — no malaria",
          "colour": "GREEN",
          "logic": null,
          "action": "Do not give an antimalarial. Look for and treat another cause of the fever, give paracetamol for high fever, and advise return in 2 days if the fever persists.",
          "treatments": ["Paracetamol for fever above 38.5C", "Assess and treat other causes", "Return in 2 days if fever persists"],
          "referralRequired": false,
          "urgentReferral": false
        }
      ],
      "testCases": [
        {"name": "stiff neck with fever is very severe febrile disease", "facts": {"ageDays": 400, "feelsHot": "PRESENT", "stiffNeck": "PRESENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "VERY_SEVERE_FEBRILE_DISEASE"},
        {"name": "a positive test is malaria", "facts": {"ageDays": 400, "feelsHot": "PRESENT", "unableToDrinkOrBreastfeed": "ABSENT", "vomitsEverything": "ABSENT", "convulsions": "ABSENT", "lethargicOrUnconscious": "ABSENT", "stiffNeck": "ABSENT", "bulgingFontanelle": "ABSENT", "malariaTestResult": "POSITIVE"}, "expectStatus": "CLASSIFIED", "expectClassification": "MALARIA"},
        {"name": "a negative test is fever without malaria", "facts": {"ageDays": 400, "feelsHot": "PRESENT", "unableToDrinkOrBreastfeed": "ABSENT", "vomitsEverything": "ABSENT", "convulsions": "ABSENT", "lethargicOrUnconscious": "ABSENT", "stiffNeck": "ABSENT", "bulgingFontanelle": "ABSENT", "malariaTestResult": "NEGATIVE"}, "expectStatus": "CLASSIFIED", "expectClassification": "FEVER_NO_MALARIA"},
        {"name": "fever with no test and no neck examination is indeterminate, never no-malaria", "facts": {"ageDays": 400, "feelsHot": "PRESENT"}, "expectStatus": "INDETERMINATE"},
        {"name": "no fever by history and not hot to touch, with no thermometer, is not a fever", "facts": {"ageDays": 400, "feverByHistory": "ABSENT", "feelsHot": "ABSENT"}, "expectStatus": "NOT_APPLICABLE"},
        {"name": "a measured temperature still triggers the table when the carer reported no fever", "facts": {"ageDays": 400, "feverByHistory": "ABSENT", "feelsHot": "ABSENT", "vitals": {"temperature": 38.9}, "unableToDrinkOrBreastfeed": "ABSENT", "vomitsEverything": "ABSENT", "convulsions": "ABSENT", "lethargicOrUnconscious": "ABSENT", "stiffNeck": "ABSENT", "bulgingFontanelle": "ABSENT", "malariaTestResult": "NEGATIVE"}, "expectStatus": "CLASSIFIED", "expectClassification": "FEVER_NO_MALARIA"}
      ]
    },

    {
      "tableId": "IMNCI_MEASLES",
      "name": "Fever with measles",
      "axis": "Measles complications",
      "ageMinDays": 60,
      "ageMaxDays": 1824,
      "appliesWhen": {
        "all": [
          {"any": [
            {"finding": "feverByHistory", "present": true},
            {"finding": "feelsHot", "present": true},
            {"input": "vitals.temperature", "op": "gte", "value": 37.5, "optionalCriterion": true}
          ]},
          {"any": [
            {"finding": "generalisedRash", "present": true},
            {"finding": "measlesWithinThreeMonths", "present": true}
          ]}
        ]
      },
      "requiredInputs": ["cornealClouding", "mouthUlcers", "pusDrainingFromEye"],
      "sourceRefs": ["WHO IMNCI chart booklet — measles"],
      "tiers": [
        {
          "code": "SEVERE_COMPLICATED_MEASLES",
          "name": "Severe complicated measles",
          "colour": "PINK",
          "logic": {
            "any": [
              {"finding": "unableToDrinkOrBreastfeed", "present": true},
              {"finding": "vomitsEverything", "present": true},
              {"finding": "convulsions", "present": true},
              {"finding": "lethargicOrUnconscious", "present": true},
              {"finding": "cornealClouding", "present": true},
              {"input": "mouthUlcers", "op": "eq", "value": "DEEP_OR_EXTENSIVE"}
            ]
          },
          "action": "Give vitamin A, the first dose of an antibiotic, tetracycline eye ointment if the cornea is clouded, and refer urgently.",
          "treatments": ["Vitamin A", "First dose of antibiotic", "Tetracycline eye ointment", "Urgent referral"],
          "referralRequired": true,
          "urgentReferral": true
        },
        {
          "code": "MEASLES_WITH_EYE_OR_MOUTH_COMPLICATIONS",
          "name": "Measles with eye or mouth complications",
          "colour": "YELLOW",
          "logic": {
            "any": [
              {"finding": "pusDrainingFromEye", "present": true},
              {"input": "mouthUlcers", "op": "eq", "value": "PRESENT_NOT_DEEP"}
            ]
          },
          "action": "Give vitamin A, treat the eye with tetracycline ointment or the mouth with gentian violet, and review in 3 days.",
          "treatments": ["Vitamin A", "Tetracycline eye ointment", "Gentian violet for mouth ulcers", "Follow-up in 3 days"],
          "referralRequired": false,
          "urgentReferral": false
        },
        {
          "code": "MEASLES",
          "name": "Measles",
          "colour": "GREEN",
          "logic": null,
          "action": "Give vitamin A and advise on home care and the return signs.",
          "treatments": ["Vitamin A", "Home care advice"],
          "referralRequired": false,
          "urgentReferral": false
        }
      ],
      "testCases": [
        {"name": "clouded cornea is severe complicated measles", "facts": {"ageDays": 400, "feelsHot": "PRESENT", "generalisedRash": "PRESENT", "cornealClouding": "PRESENT"}, "expectStatus": "CLASSIFIED", "expectClassification": "SEVERE_COMPLICATED_MEASLES"},
        {"name": "fever without a rash means the table does not apply", "facts": {"ageDays": 400, "feelsHot": "PRESENT", "generalisedRash": "ABSENT", "measlesWithinThreeMonths": "ABSENT"}, "expectStatus": "NOT_APPLICABLE"}
      ]
    },

    {
      "tableId": "IMNCI_EAR",
