  "items": [
    {
      "code": "CXR-001",
      "sourcePage": 31,
      "sourceHeading": "MINIMUM REQUIREMENTS- CONVENTIONAL RADIOLOGY",
      "requirement": "Conventional radiography room size shall be at least 20 square meters in floor area and more than 3m in height.",
      "requirementType": "MEASUREMENT",
      "obligation": "MANDATORY",
      "responseType": "MEASUREMENT",
      "evidence": "MEASUREMENT",
      "measurement": {"dimension": "radiography room floor area and ceiling height", "unit": "m2 / m", "expected": "at least 20 square meters floor area and more than 3 m height as stated"}
    },
    {
      "code": "CXR-002",
      "sourcePage": 31,
      "sourceHeading": "MINIMUM REQUIREMENTS- CONVENTIONAL RADIOLOGY",
      "requirement": "Room entrance shall not be less than 1.2m and 2 meters height, with shielded door.",
      "requirementType": "MEASUREMENT",
      "obligation": "MANDATORY",
      "responseType": "MEASUREMENT",
      "evidence": "MEASUREMENT",
      "measurement": {"dimension": "room entrance width and height", "unit": "m", "expected": "not less than 1.2 m and 2 m height as stated; door shielded"}
    },
    {
      "code": "CXR-003",
      "sourcePage": 31,
      "sourceHeading": "MINIMUM REQUIREMENTS- CONVENTIONAL RADIOLOGY",
      "requirement": "At least one designated patient gowning area for patient changing with safe storage for valuables and clothing shall be provided. At least this area shall be 1.5 meters x 1.2 meters with immediate access to the conventional radiography room.",
      "requirementType": "MEASUREMENT",
      "obligation": "MANDATORY",
      "responseType": "MEASUREMENT",
      "evidence": "MEASUREMENT",
      "measurement": {"dimension": "patient gowning area size", "unit": "m", "expected": "at least 1.5 m x 1.2 m as stated"},
      "quantity": "at least one designated patient gowning area"
    },
    {
      "code": "CXR-004",
      "sourcePage": 31,
      "sourceHeading": "MINIMUM REQUIREMENTS- CONVENTIONAL RADIOLOGY",
