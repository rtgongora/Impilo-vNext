      "obligation": "MANDATORY",
      "responseType": "MEASUREMENT",
      "evidence": "MEASUREMENT",
      "measurement": {"dimension": "illumination level", "unit": "Candela", "expected": "up to 540 Candela as stated"}
    },
    {
      "code": "CXR-009",
      "sourcePage": 31,
      "sourceHeading": "MINIMUM REQUIREMENTS- CONVENTIONAL RADIOLOGY",
      "requirement": "If film systems are used, a darkroom shall be provided for processing films (at least 2 meters square) with water basin, table, benches, film holder and safe light.",
      "requirementType": "FACILITY",
      "obligation": "WHERE_APPLICABLE",
      "applicability": "where film systems are used",
      "conditional": "if film systems are used",
      "responseType": "MEASUREMENT",
      "evidence": "MEASUREMENT",
      "measurement": {"dimension": "darkroom size", "expected": "at least 2 meters square as stated"}
    },
    {
      "code": "CXR-010",
      "sourcePage": 32,
      "sourceHeading": "MINIMUM REQUIREMENTS- CONVENTIONAL RADIOLOGY",
      "requirement": "When daylight processing is used, the darkroom shall be permitted to be minimal for emergency and special uses.",
      "requirementType": "FACILITY",
      "obligation": "WHERE_APPLICABLE",
      "applicability": "when daylight processing is used",
