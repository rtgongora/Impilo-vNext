<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zw.gov.mohcc.impilo</groupId>
        <artifactId>impilo-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>mental-health-service</artifactId>
    <name>Mental Health — Psychiatric Emergency Acceptance &amp; Handover</name>
    <description>
        The accepting counterparty for a psychiatric emergency handover (TO_MENTAL_HEALTH):
        referral intake/accept/decline, risk formulation, capacity/mental-state assessment,
        safety planning, involuntary-episode legal-basis tracking, a restraint-REDUCTION
        register (every event carries a de-escalation-attempted record and a review), and
        admission requests that raise to PCT without deciding. Care Continuum component
        (continuum_parent: pct-service) — does not own the admission decision, person-level
        longitudinal registries, or a second care continuum.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Tech Companion — v1.1 auto-configuration -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>tech-companion</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Shared security baseline + TrustContext -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>shared-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Shared Kernel: EventEnvelope, CompanionOutboxPublisher, IdentityRepointHook -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>shared-kernel-java</artifactId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
