<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zw.gov.mohcc.impilo</groupId>
        <artifactId>impilo-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>experience-bff</artifactId>
    <packaging>jar</packaging>
    <name>Impilo — Experience BFF</name>
    <description>
        Backend-for-Frontend for the Experience UI. Implements v1.1 header enforcement,
        idempotency, outbox pattern, and proxies/orchestrates calls to platform services.
        Replaces Supabase API surface from prototype with platform-native implementation.
    </description>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Redis Cache -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Resilience4j (version not managed by Spring Boot parent BOM) -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- PostgreSQL and Flyway REMOVED — BFF is a pure proxy with no database -->
        <!-- All data owned by sovereign services, accessed via typed HTTP clients -->

        <!-- RFC 4180 CSV parsing for governed import -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.11.0</version>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Spring Security OAuth2 Resource Server (JWT validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Spring Kafka -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Tech Companion (v1.1 enforcement) -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>tech-companion</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>shared-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>tshepo-contracts</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Shared Kernel Java (EventEnvelope) -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>shared-kernel-java</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers PostgreSQL REMOVED — BFF has no database -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.10.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Tech Companion Harness (GoldenContractSuite) -->
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>tech-companion-harness</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Align with parent Byte Buddy flag; disable JVM system proxies so docker-java
                 talks to Docker Desktop engine API without corporate HTTP(S)_PROXY interference. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true -Djava.net.useSystemProxies=false</argLine>
                    <environmentVariables>
                        <NO_PROXY>localhost,127.0.0.1,::1,*.docker.internal,docker.for.win.localhost,docker.for.mac.localhost</NO_PROXY>
                        <!-- Deterministic auth fallback in tests (ROPC hits closed port, not a real Keycloak 401). -->
                        <KEYCLOAK_URL>http://127.0.0.1:1</KEYCLOAK_URL>
                    </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
