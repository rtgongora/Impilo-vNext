#!/usr/bin/env bash
# Root-only: import approved Impilo images from local Docker into k3s containerd.
# Default: required_full_boot + infra, missing-only (no all-tag sweep).
# Usage: impilo-k3s-import-images <tag> [repo_path] [--only id1,id2] [--runtime-only] [--all-local-preview] [--force]
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "ERROR: must run as root (via sudo /usr/local/sbin/impilo-k3s-import-images)" >&2
  exit 1
fi

LIB="/usr/local/libexec/impilo/k3s-image-helper-common.sh"
if [[ ! -f "$LIB" ]]; then
  echo "ERROR: missing $LIB (re-run install-k3s-image-helper.sh)" >&2
  exit 1
fi
# shellcheck source=/usr/local/libexec/impilo/k3s-image-helper-common.sh
source "$LIB"

echo "IMPILO_HELPER_VERSION=$IMPILO_HELPER_VERSION"

TAG="${1:-}"
REPO="${2:-$IMPILO_DEFAULT_REPO}"
shift 2 2>/dev/null || true
ONLY_IDS=""
ALL_LOCAL_PREVIEW=0
RUNTIME_ONLY=0
FORCE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --only)
      ONLY_IDS="${2:-}"
      shift 2
      ;;
    --runtime-only)
      RUNTIME_ONLY=1
      shift
      ;;
    --all-local-preview)
      ALL_LOCAL_PREVIEW=1
      shift
      ;;
    --force)
      FORCE=1
      shift
      ;;
    *)
      echo "ERROR: unknown argument: $1" >&2
      echo "Usage: impilo-k3s-import-images <tag> [repo] [--only id1,id2] [--runtime-only] [--all-local-preview] [--force]" >&2
      exit 2
      ;;
  esac
done

impilo_validate_tag "$TAG" || exit 2
impilo_validate_repo "$REPO" || exit 2

if ! command -v docker >/dev/null 2>&1; then
  echo "ERROR: docker required" >&2
  impilo_helper_log "import FAIL: docker missing tag=$TAG"
  exit 1
fi

if ! impilo_acquire_import_lock; then
  exit 3
fi

impilo_helper_log "import START tag=$TAG repo=$REPO only=${ONLY_IDS:-none} runtime_only=$RUNTIME_ONLY all_local=$ALL_LOCAL_PREVIEW force=$FORCE"

IMPORTED=0
FAILED=0
SKIPPED=0
CTR_CACHE="$(mktemp)"
impilo_ctr_list >"$CTR_CACHE" || true

import_ref() {
  local ref="$1"
  local required="${2:-0}"
  if [[ "$FORCE" != "1" ]] && impilo_ref_in_containerd "$ref" "$CTR_CACHE"; then
    echo "SKIP  $ref  (already in containerd)"
    impilo_helper_log "SKIP present $ref"
    SKIPPED=$((SKIPPED + 1))
    return 0
  fi
  if ! docker image inspect "$ref" >/dev/null 2>&1; then
    if [[ "$required" == "1" ]]; then
      echo "FAIL  $ref  (required image not in local docker)"
      impilo_helper_log "FAIL required missing docker $ref"
      FAILED=$((FAILED + 1))
      return 1
    fi
    echo "SKIP  $ref  (not in local docker)"
    SKIPPED=$((SKIPPED + 1))
    return 0
  fi
  local safe
  safe="$(echo "$ref" | tr '/:@' '___')"
  local tar="/tmp/impilo-image-${safe}.tar"
  echo "IMPORT  $ref"
  if ! docker save "$ref" -o "$tar"; then
    echo "FAIL  $ref  (docker save)"
    FAILED=$((FAILED + 1))
    rm -f "$tar"
    return 1
  fi
  if impilo_ctr_import "$tar"; then
    IMPORTED=$((IMPORTED + 1))
    impilo_helper_log "OK $ref"
    impilo_ctr_list >>"$CTR_CACHE" 2>/dev/null || true
  else
    echo "FAIL  $ref  (ctr import)"
    FAILED=$((FAILED + 1))
  fi
  rm -f "$tar"
}

resolve_docker_ref() {
  local sid="$1"
  local candidates=(
    "127.0.0.1:5000/impilo/${sid}:${TAG}"
    "impilo/${sid}:${TAG}"
  )
  local c
  for c in "${candidates[@]}"; do
    if docker image inspect "$c" >/dev/null 2>&1; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

mapfile -t REQUIRED < <(impilo_required_refs "$TAG" "$REPO")
if [[ -n "$ONLY_IDS" ]]; then
  if [[ "$RUNTIME_ONLY" == "1" ]]; then
    impilo_helper_log "import MODE runtime-selected ids=$ONLY_IDS"
    echo "MODE: runtime-selected import (--runtime-only --only)"
    IFS=',' read -ra WANT <<<"$ONLY_IDS"
    for w in "${WANT[@]}"; do
      w="${w// /}"
      [[ -z "$w" ]] && continue
      if ref="$(resolve_docker_ref "$w")"; then
        import_ref "$ref" 1 || true
      else
        echo "FAIL  impilo/${w}:${TAG}  (not in local docker)"
        impilo_helper_log "FAIL runtime missing docker impilo/${w}:${TAG}"
        FAILED=$((FAILED + 1))
      fi
    done
    echo ""
    echo "imported_count=$IMPORTED failed_count=$FAILED skipped_count=$SKIPPED (runtime-selected)"
    impilo_helper_log "import END runtime-selected imported=$IMPORTED failed=$FAILED skipped=$SKIPPED"
    rm -f "$CTR_CACHE"
    [[ "$FAILED" -gt 0 ]] && exit 1
    exit 0
  fi

  impilo_helper_log "import MODE selected-only ids=$ONLY_IDS"
  FILTERED=()
  IFS=',' read -ra WANT <<<"$ONLY_IDS"
  for ref in "${REQUIRED[@]}"; do
    [[ -n "$ref" ]] || continue
    sid="${ref#impilo/}"
    sid="${sid%%:*}"
    for w in "${WANT[@]}"; do
      w="${w// /}"
      [[ -z "$w" ]] && continue
      if [[ "$sid" == "$w" ]]; then
        if resolved="$(resolve_docker_ref "$sid")"; then
          FILTERED+=("$resolved")
        else
          FILTERED+=("$ref")
        fi
        break
      fi
    done
  done
  REQUIRED=("${FILTERED[@]}")
  if [[ ${#REQUIRED[@]} -eq 0 ]]; then
    echo "ERROR: --only did not match any required_full_boot refs" >&2
    rm -f "$CTR_CACHE"
    exit 2
  fi
  for ref in "${REQUIRED[@]}"; do
    import_ref "$ref" 1 || true
  done
  echo ""
  echo "imported_count=$IMPORTED failed_count=$FAILED skipped_count=$SKIPPED (selected-only)"
  impilo_helper_log "import END selected-only imported=$IMPORTED failed=$FAILED skipped=$SKIPPED"
  rm -f "$CTR_CACHE"
  [[ "$FAILED" -gt 0 ]] && exit 1
  exit 0
fi

echo "MODE: required+infra missing-only (use --all-local-preview for full tag sweep)"
for ref in "${REQUIRED[@]}"; do
  [[ -n "$ref" ]] || continue
  # Prefer registry-prefixed local tags so containerd refs match digest-pinned pulls.
  sid="${ref#impilo/}"
  sid="${sid%%:*}"
  if [[ "$ref" == impilo/* ]] && resolved="$(resolve_docker_ref "$sid")"; then
    import_ref "$resolved" 1 || true
  else
    import_ref "$ref" 1 || true
  fi
done

while read -r ref; do
  [[ -n "$ref" ]] || continue
  if printf '%s\n' "${REQUIRED[@]}" | grep -qxF "$ref" 2>/dev/null; then
    continue
  fi
  import_ref "$ref" 1 || true
done < <(impilo_infra_refs)

if [[ "$ALL_LOCAL_PREVIEW" == "1" ]]; then
  echo "MODE: --all-local-preview sweep (impilo/* and 127.0.0.1:5000/impilo/* :${TAG} and preview-*)"
  while read -r ref; do
    [[ -n "$ref" ]] || continue
    if printf '%s\n' "${REQUIRED[@]}" | grep -qxF "$ref" 2>/dev/null; then
      continue
    fi
    import_ref "$ref" 0 || true
  done < <(docker images --format '{{.Repository}}:{{.Tag}}' | grep -E "^(127\\.0\\.0\\.1:5000/)?impilo/.+:(${TAG}|preview-)" || true)
else
  echo "SKIP: all-local-preview sweep disabled (pass --all-local-preview to enable)"
fi

echo ""
echo "imported_count=$IMPORTED failed_count=$FAILED skipped_count=$SKIPPED"
impilo_helper_log "import END imported=$IMPORTED failed=$FAILED skipped=$SKIPPED tag=$TAG"

rm -f "$CTR_CACHE"
if [[ "$FAILED" -gt 0 ]]; then
  exit 1
fi

CTR_LIST="$(mktemp)"
impilo_ctr_list >"$CTR_LIST" || true
set +e
impilo_check_presence "$TAG" "$REPO" "$CTR_LIST"
check_exit=$?
set -e
rm -f "$CTR_LIST"
if [[ "$check_exit" -ne 0 ]]; then
  impilo_helper_log "import FAIL: post-import verify missing required images"
  exit 1
fi
exit 0
