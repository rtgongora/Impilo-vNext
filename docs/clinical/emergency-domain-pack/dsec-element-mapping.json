  "note": "This mapping is honest about absence. MAPPED means a projection column or derived indicator exists. PARTIAL means the column exists but the upstream event rarely/never fills it yet. UNMAPPED means the estate does not yet capture the element — listing it here is the point of the register, not a claim of coverage.",
  "coreElements": [
    {"id": "DSEC-C01", "group": "registration", "element": "Facility identifier", "mapping": "MAPPED", "target": "rpt_emergency_episode_metric.facility_id"},
    {"id": "DSEC-C02", "group": "registration", "element": "Unique encounter / episode identifier", "mapping": "MAPPED", "target": "rpt_emergency_episode_metric.episode_id (+ episode_reference)"},
    {"id": "DSEC-C03", "group": "registration", "element": "Arrival date/time", "mapping": "MAPPED", "target": "rpt_emergency_episode_metric.opened_at (from arrivedAt on EMERGENCY_EPISODE_OPENED)"},
    {"id": "DSEC-C04", "group": "registration", "element": "Mode of arrival / entry route", "mapping": "MAPPED", "target": "rpt_emergency_episode_metric.entry_route"},
    {"id": "DSEC-C05", "group": "registration", "element": "Patient identifier (CPID)", "mapping": "PARTIAL", "target": "rpt_emergency_episode_metric.subject_cpid (absent for unlinked provisional identity)"},
    {"id": "DSEC-C06", "group": "registration", "element": "Sex", "mapping": "UNMAPPED", "target": "VITO person demographics — not projected (PII stays out of reporting projection)"},
