{
  "id": "impilo",
  "realm": "impilo",
  "enabled": true,
  "displayName": "Impilo vNext",
  "displayNameHtml": "<strong>Impilo vNext</strong>",
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "sslRequired": "none",
  "accessTokenLifespan": 28800,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "defaultSignatureAlgorithm": "RS256",
  "bruteForceProtected": false,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "internationalizationEnabled": false,
  "defaultLocale": "en",
  "roles": {
    "realm": [
      {
        "name": "SYSTEM_ADMIN",
        "description": "Full platform administrator with unrestricted access",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "FACILITY_ADMIN",
        "description": "Administrator scoped to a single facility",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CLINICIAN",
        "description": "Licensed medical practitioner (doctor, specialist)",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "NURSE",
        "description": "Registered or enrolled nurse",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "PHARMACIST",
        "description": "Licensed pharmacist with dispensing authority",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CITIZEN",
        "description": "Patient or citizen accessing personal health records",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "SUPPORT_AGENT",
        "description": "Help-desk or support staff",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "DEVELOPER",
        "description": "Developer role for integration and debugging",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "FINANCE",
        "description": "Finance officer with access to billing, claims, payments, and tariffs",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clientScopes": [
    {
      "name": "openid",
      "description": "OpenID Connect scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${profileScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "given name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "firstName",
            "claim.name": "given_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "family name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "lastName",
            "claim.name": "family_name",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${emailScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "roles",
      "description": "Adds realm roles to access token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "impilo-tenant",
      "description": "Adds tenant_id claim to access tokens",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "moh-zw",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "openid",
    "profile",
    "email",
    "roles",
    "impilo-tenant"
  ],
  "clients": [
    {
      "clientId": "experience-ui",
      "name": "Impilo web experience (OIDC \u2014 primary browser / ROPC client)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://197.221.242.150:3000/*",
        "http://197.221.242.150/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://197.221.242.150:3000",
        "http://197.221.242.150"
      ],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles",
        "impilo-tenant"
      ]
    },
    {
      "clientId": "citizen-portal",
