      "serviceAccountsEnabled": true,
      "secret": "impilo-backend-secret",
      "redirectUris": [],
      "webOrigins": [],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": ["openid", "profile", "email", "impilo-tenant"],
      "protocolMappers": [
        {
          "name": "facility_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "facility_id",
            "claim.name": "facility_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "realm-management-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "realm-management",
            "claim.name": "resource_access.realm-management.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "integration-test",
      "name": "Integration Test Harness",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "secret": "integration-test-secret",
      "redirectUris": [],
      "webOrigins": [],
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": ["openid", "profile", "email", "impilo-tenant"]
    },
    {
      "clientId": "citizen-app",
      "name": "Impilo Citizen App (Mobile)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "impilo-citizen://auth/callback",
        "exp://192.168.100.211:2507/*",
        "exp://192.168.100.211:8081/*",
        "exp://192.168.100.211:8082/*",
        "exp://192.168.100.211:8083/*",
        "exp://192.168.100.211:8084/*",
        "exp://192.168.100.211:8085/*",
        "exp://127.0.0.1:2507/*",
        "exp://127.0.0.1:8081/*",
        "exp://127.0.0.1:8082/*",
        "exp://127.0.0.1:8083/*",
        "http://localhost:8081/*",
        "http://192.168.100.211:8081/*"
      ],
      "webOrigins": [],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
