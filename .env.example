# ===================================================================
# Impilo vNext — Local Development Environment Variables
# Copy to .env and fill in values. NEVER commit .env to source control.
# ===================================================================

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=impilo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=impilo

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- Kafka -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ----- LAN testing (second device on same Wi‑Fi) -----
# Set to your machine's Wi‑Fi LAN IP (ipconfig → IPv4), then restart compose.
# Other devices open ONLY http://<HOST_LAN_IP>:3000 — API and WebRTC signaling
# are proxied through the UI port. Allow TCP 3000 in Windows Firewall.
# WebRTC media may still need UDP 3478 and 49152-49200 if TURN is required.
HOST_LAN_IP=192.168.1.100

# ----- Keycloak -----
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=impilo
KEYCLOAK_CLIENT_ID=impilo-ui
KEYCLOAK_CLIENT_SECRET=changeme

# ----- MinIO (S3-compatible) -----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=impilo-docs

# ----- HAPI FHIR (BUTANO) -----
HAPI_FHIR_URL=http://localhost:8090/fhir

# ----- Orthanc (PACS) -----
ORTHANC_URL=http://localhost:8042

# ----- TSHEPO -----
TSHEPO_URL=http://localhost:8081
TSHEPO_PEPPER=changeme-generate-a-real-pepper

# ----- Envoy Gateway -----
ENVOY_ADMIN_PORT=9901

# ----- Observability -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ----- Experience UI + BFF (local) -----
# Next.js rewrites /internal/* to the BFF (see ui/experience/next.config.mjs).
# NEXT_PUBLIC_BFF_URL=http://localhost:8160
# BFF → sovereign Mvumo (Ring 0, same class as Tshepo / VITO base URLs in application.yml)
# MVUMO_BASE_URL=http://localhost:8195
