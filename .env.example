# ===================================================================
# Impilo vNext — Local Development Environment Variables
# Copy to .env and fill in values. NEVER commit .env to source control.
# ===================================================================

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=impilo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=impilo

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- Kafka -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ----- Keycloak -----
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=impilo
KEYCLOAK_CLIENT_ID=impilo-ui
KEYCLOAK_CLIENT_SECRET=changeme

# ----- MinIO (S3-compatible) -----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=impilo-docs

# ----- HAPI FHIR (BUTANO) -----
HAPI_FHIR_URL=http://localhost:8090/fhir

# ----- Orthanc (PACS) -----
ORTHANC_URL=http://localhost:8042
ORTHANC_BASE_URL=http://localhost:8042
ORTHANC_DICOMWEB_URL=http://localhost:8042/dicom-web
PACS_BACKEND_MODE=EMBEDDED
PACS_BACKEND_PROVIDER=ORTHANC
PACS_EXTERNAL_BASE_URL=
PACS_EXTERNAL_DICOMWEB_ENABLED=true
PACS_EXTERNAL_DIMSE_ENABLED=false
IMAGING_VIEWER_DEFAULT_ENGINE=DICOMWEB_STACK
IMAGING_VIEWER_SUPPORTED_ENGINES=DICOMWEB_STACK,OHIF,CORNERSTONE

# PACS mode examples:
# - Embedded mode (default): PACS_BACKEND_MODE=EMBEDDED, PACS_BACKEND_PROVIDER=ORTHANC
# - External mode: PACS_BACKEND_MODE=EXTERNAL, PACS_BACKEND_PROVIDER=EXTERNAL, PACS_EXTERNAL_BASE_URL=https://pacs.example.org
# - Hybrid mode: PACS_BACKEND_MODE=HYBRID (per-facility selection), provider routing follows runtime policies

# ----- TSHEPO -----
TSHEPO_URL=http://localhost:8081
TSHEPO_PEPPER=changeme-generate-a-real-pepper

# ----- Envoy Gateway -----
ENVOY_ADMIN_PORT=9901

# ----- Observability -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ----- Experience UI + BFF (local) -----
# Next.js rewrites /internal/* to the BFF (see ui/experience/next.config.mjs).
# NEXT_PUBLIC_BFF_URL=http://localhost:8160
# Optional OHIF embed base URL (for viewerType=OHIF mode).
# NEXT_PUBLIC_OHIF_BASE_URL=http://localhost:3005
# BFF → sovereign Mvumo (Ring 0, same class as Tshepo / VITO base URLs in application.yml)
# MVUMO_BASE_URL=http://localhost:8195

# ----- Telemedicine RTC Gateway / LiveKit -----
# PCT remains the telemedicine workflow owner. RTC Gateway is only the media adapter.
RTC_PROVIDER=LIVEKIT
RTC_FAIL_CLOSED=true
RTC_DEV_MODE_ENABLED=false
RTC_TOKEN_TTL_SECONDS=3600
RTC_RECORDING_ENABLED=false
RTC_EGRESS_ENABLED=false
RTC_REQUIRE_CONSENT_REFERENCE_FOR_MEDIA=true
RTC_ALLOW_EMERGENCY_WITHOUT_CONSENT=true
RTC_GATEWAY_BASE_URL=http://localhost:8195
LIVEKIT_ENABLED=true
LIVEKIT_URL=http://localhost:7880
LIVEKIT_CLIENT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
PCT_TELEMED_EXTERNAL_ENABLED=true
PCT_TELEMED_EXTERNAL_BASE_URL=http://localhost:8195
PCT_TELEMED_EXTERNAL_SESSION_PATH=/internal/v1/rtc/sessions
PCT_TELEMED_EXTERNAL_API_KEY=
PCT_TELEMED_FALLBACK_TO_MANAGED_PRIMARY=false
PCT_TELEMED_REQUIRE_CONSENT_REFERENCE_FOR_MEDIA=true
PCT_TELEMED_ALLOW_EMERGENCY_WITHOUT_CONSENT=true
IMPILO_TELEMEDICINE_REQUIRE_TSHEPO_AUTHORIZE=true
IMPILO_TELEMEDICINE_TSHEPO_PDP_FALLBACK_ALLOW=false
IMPILO_TELEMEDICINE_AUDIT_INGEST_ENABLED=true
IMPILO_TELEMEDICINE_REQUIRE_MEDIA_CONSENT_REFERENCE=true
IMPILO_TELEMEDICINE_ALLOW_EMERGENCY_WITHOUT_CONSENT=true
IMPILO_TELEMEDICINE_ALLOWED_PURPOSE_OF_USE=TREATMENT,EMERGENCY,PAYMENT,OPERATIONS,PUBLIC_HEALTH

# ----- LLM Adapter Layer -----
LLM_ENABLED=true
LLM_DEFAULT_PROVIDER=gemini
LLM_ALLOWED_PROVIDERS=gemini,openai,anthropic,deepseek,deterministic,mock
LLM_FALLBACK_PROVIDER=deterministic
LLM_PROVIDER_ROUTING_MODE=capability_then_priority
LLM_REQUIRE_HUMAN_APPROVAL_FOR_HIGH_RISK_ACTIONS=true
LLM_AUDIT_ENABLED=true
LLM_TOOL_CALLING_ENABLED=true
LLM_STRUCTURED_OUTPUTS_ENABLED=true
LLM_TIMEOUT_MS=30000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_BACKOFF_MS=500
LLM_ORCHESTRATION_BASE_URL=http://localhost:8265
LLM_GEMINI_ENABLED=true
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-3-flash-preview
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
LLM_GEMINI_PRIORITY=1
LLM_OPENAI_ENABLED=true
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-5.1
LLM_OPENAI_BASE_URL=https://api.openai.com
LLM_OPENAI_PRIORITY=2
LLM_ANTHROPIC_ENABLED=true
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=claude-sonnet-4.5
LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_ANTHROPIC_PRIORITY=3
LLM_DEEPSEEK_ENABLED=true
LLM_DEEPSEEK_API_KEY=
LLM_DEEPSEEK_MODEL=deepseek-v4-flash
LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_DEEPSEEK_PRIORITY=4
LLM_DETERMINISTIC_ENABLED=true
LLM_MOCK_ENABLED=true

# ----- NDILA — Geospatial Intelligence & Spatial Orchestration -----
# Ndila is the shared spatial intelligence layer (location, routing, geofencing,
# catchments, tracking, spatial search, AI-safe context packets). Provider
# selection is policy-driven; the defaults below keep dev/test deterministic.
# Nhume consumes Ndila for all map/geospatial concerns — do not hard-code a
# map provider directly into Nhume.
NDILA_BASE_URL=http://localhost:8155
NDILA_DEFAULT_PROVIDER=MOCK
NDILA_GEOCODING_PROVIDER=MOCK
NDILA_ROUTING_PROVIDER=MOCK
NDILA_TILE_PROVIDER=MOCK
# Block public OSM tile servers in production. Required to be "true" outside dev.
NDILA_BLOCK_PUBLIC_OSM_TILES_IN_PROD=true
# Enable PostGIS column types in the Ndila Flyway migration when available.
# Set to true only when the cluster uses the postgis/postgis image.
NDILA_POSTGIS_ENABLED=false
# Optional OSRM / Nominatim / Pelias backends (leave blank for fully-local dev).
NDILA_OSRM_BASE_URL=
NDILA_NOMINATIM_BASE_URL=
NDILA_PELIAS_BASE_URL=
# Optional commercial providers — disabled and unconfigured by default.
NDILA_MAPBOX_TOKEN=
NDILA_GOOGLE_MAPS_API_KEY=
NDILA_HERE_API_KEY=
NDILA_AZURE_MAPS_KEY=
# Sovereign / national GIS overlay (placeholder, used by the ZW GIS adapter).
NDILA_ZW_GIS_BASE_URL=
# Where Ndila stores offline tile bundles (MinIO bucket).
NDILA_OFFLINE_TILE_BUCKET=ndila-offline-tiles
# Sensitivity ceiling beyond which Ndila must never call third-party providers.
NDILA_EXTERNAL_PROVIDER_MAX_SENSITIVITY=INTERNAL

# ===================================================================
# Nhume — Dispatch, Delivery, Fleet Tracking & Last-Mile Logistics
# ===================================================================
# Nhume service is registered at services/nhume-service and exposes:
#   - Public API     : /api/v1/nhume/**
#   - Internal API   : /internal/v1/nhume/**
#   - Event prefix   : nhume.*
#   - DB table prefix: nhume_
# Map / geospatial concerns are consumed via NDILA above (NDILA_BASE_URL).

# ----- Nhume service binding (Spring Boot) -----
NHUME_SERVICE_PORT=8210
NHUME_SERVICE_BASE_URL=http://localhost:8210

# ----- Nhume database (uses shared Postgres by default) -----
# Override only if you want Nhume to point at a dedicated DB.
# NHUME_DB_HOST=${POSTGRES_HOST}
# NHUME_DB_PORT=${POSTGRES_PORT}
# NHUME_DB_NAME=${POSTGRES_DB}
# NHUME_DB_USER=${POSTGRES_USER}
# NHUME_DB_PASSWORD=${POSTGRES_PASSWORD}

# ----- Comms Hub / Omnichannel (notifications) -----
# When set, Nhume dispatches delivery notifications through Comms Hub
# (in-app, push, SMS, email, WhatsApp). When unset, falls back to
# LoggingCommsHubClient (events logged + persisted to outbox only).
COMMS_HUB_BASE_URL=http://localhost:8175
COMMS_HUB_TENANT_HEADER=X-Tenant-Id
COMMS_HUB_API_KEY=

# ----- Trust Layer (TSHEPO) -----
# Already configured above as TSHEPO_URL. Nhume requires these headers on
# every sensitive call (enforced by TrustLayerGuard):
#   X-Tenant-Id, X-Correlation-Id, X-Actor-Id, X-Actor-Type,
#   X-Purpose-Of-Use, X-Facility-Id, X-Workspace-Id, X-Shift-Id,
#   X-Device-Fingerprint
# No additional env vars required beyond TSHEPO_URL.

# ----- GPS / telemetry ingestion -----
# Maximum rate at which Nhume will accept location updates from a single
# courier/asset before throttling (per minute).
NHUME_LOCATION_INGEST_RATE_LIMIT=60
# How long to retain raw tracking events before downsampling/archiving (days).
NHUME_LOCATION_RETENTION_DAYS=30
# How long to retain webhook payloads (days).
NHUME_WEBHOOK_RETENTION_DAYS=90

# ----- Webhook signing (third-party logistics & autonomous providers) -----
# HMAC-SHA256 shared secret used by NhumeWebhookController to verify
# inbound webhooks. Per-provider secrets override this default and are
# stored in nhume_integration_provider.signing_secret.
NHUME_WEBHOOK_SIGNING_SECRET=changeme-generate-a-real-hmac-secret
NHUME_WEBHOOK_SIGNATURE_HEADER=X-Nhume-Signature
NHUME_WEBHOOK_TIMESTAMP_HEADER=X-Nhume-Timestamp
NHUME_WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300

# ----- Autonomous delivery providers (drone, UAV, robot, AV, smart locker) -----
# Nhume ships with a SimulatedAutonomousAdapter for development/demo.
# Real provider adapters are resolved at runtime by providerCode
# (see AutonomousAdapterRegistry). Configure per-provider credentials
# in nhume_integration_provider table; the following are global defaults.
NHUME_AUTONOMOUS_DEFAULT_PROVIDER=simulated
NHUME_AUTONOMOUS_SIMULATION_MODE=true
# Example provider-specific creds (commented out — populate per deployment):
# NHUME_PROVIDER_ZIPLINE_API_KEY=
# NHUME_PROVIDER_ZIPLINE_BASE_URL=
# NHUME_PROVIDER_WING_API_KEY=
# NHUME_PROVIDER_WING_BASE_URL=
# NHUME_PROVIDER_STARSHIP_API_KEY=

# ----- Cold-chain & sensor telemetry -----
NHUME_COLD_CHAIN_TEMP_MIN_C=2.0
NHUME_COLD_CHAIN_TEMP_MAX_C=8.0
NHUME_COLD_CHAIN_BREACH_GRACE_MINUTES=5

# ----- SLA defaults (overridden by nhume_delivery_sla rows) -----
NHUME_SLA_DEFAULT_PICKUP_MINUTES=60
NHUME_SLA_DEFAULT_DELIVERY_MINUTES=240
NHUME_SLA_EMERGENCY_DELIVERY_MINUTES=45

# ----- Mobile BFF paths (Nhume) -----
# Citizen + provider apps call these BFF-style paths. They are proxied by
# experience-bff to the Nhume internal API.
#   Citizen : /internal/v1/mobile/citizen/nhume/**
#   Provider: /internal/v1/mobile/provider/nhume/**
# No env required — wired in experience-bff routing.

# ----- Nhume feature flags -----
NHUME_FEATURE_AUTONOMOUS_ENABLED=true
NHUME_FEATURE_OFFLINE_COURIER_ENABLED=true
NHUME_FEATURE_BATCH_DISPATCH_ENABLED=true
NHUME_FEATURE_DEMO_SEED_ENABLED=true
