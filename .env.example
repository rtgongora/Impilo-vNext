# ===================================================================
# Impilo vNext — Local Development Environment Variables
# Copy to .env and fill in values. NEVER commit .env to source control.
# ===================================================================

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=impilo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=impilo

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- Kafka -----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ----- Keycloak -----
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=impilo
KEYCLOAK_CLIENT_ID=impilo-ui
KEYCLOAK_CLIENT_SECRET=changeme

# ----- One UI Shell (Next.js) — optional OIDC helpers for browser + server -----
# Public shell origin (must match Keycloak redirect URIs for one-ui-shell).
NEXT_PUBLIC_ONE_UI_SHELL_URL=http://localhost:3000
# Browser-visible Keycloak base URL (logout redirect); falls back to KEYCLOAK_URL on server.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=impilo
# Override default public client id one-ui-shell if needed.
# NEXT_PUBLIC_ONE_UI_SHELL_KEYCLOAK_CLIENT_ID=one-ui-shell
# Optional: space-separated OIDC scopes for /api/auth/login (server only).
# Default matches running Keycloak without requesting `roles` unless the realm exposes it.
# ONE_UI_SHELL_OIDC_SCOPE=openid profile email impilo-tenant

# ----- MinIO (S3-compatible) -----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=impilo-docs

# ----- HAPI FHIR (BUTANO) -----
HAPI_FHIR_URL=http://localhost:8090/fhir

# ----- Orthanc (PACS) -----
ORTHANC_URL=http://localhost:8042

# ----- TSHEPO -----
TSHEPO_URL=http://localhost:8081
TSHEPO_PEPPER=changeme-generate-a-real-pepper

# ----- Envoy Gateway -----
ENVOY_ADMIN_PORT=9901

# ----- Observability -----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
