# Preview environment — copy to .env.preview (do not commit secrets)

IMPILO_ENV=preview
IMPILO_GIT_BRANCH=claude/staging-ux-orchestration-remediation-Yypyl
IMPILO_GIT_COMMIT=local-dev
IMPILO_BUILD_DATE=

REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=impilo

# Leave NEXT_PUBLIC_* empty for same-origin (browser uses relative paths routed by Traefik; IP-independent).
NEXT_PUBLIC_BFF_URL=
NEXT_PUBLIC_IMPILO_ENV=preview
NEXT_PUBLIC_API_GATEWAY_URL=

# Preview-only — never use in production
AUTH_FALLBACK_ENABLED=true
POSTGRES_PASSWORD=preview-change-me
