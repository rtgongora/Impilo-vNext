{
  "name": "impilo-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Impilo vNext — Frontend workspace root",
  "workspaces": [
    "shared-ui",
    "one-ui-shell",
    "ops-console",
    "ehr",
    "portal",
    "ops-docs",
    "self-service",
    "butano-web",
    "pct-web",
    "zibo-web",
    "oros-web",
    "pharmacy-web",
    "inventory-web",
    "support-console"
  ],
  "scripts": {
    "dev:shell": "npm -w one-ui-shell run dev",
    "dev:ops": "npm -w ops-console run dev",
    "dev:ehr": "npm -w ehr run dev",
    "dev:portal": "npm -w portal run dev",
    "dev:docs": "npm -w ops-docs run dev",
    "dev:self": "npm -w self-service run dev",
    "dev:butano": "npm -w butano-web run dev",
    "dev:pct": "npm -w pct-web run dev",
    "dev:zibo": "npm -w zibo-web run dev",
    "dev:oros": "npm -w oros-web run dev",
    "dev:pharmacy": "npm -w pharmacy-web run dev",
    "dev:inventory": "npm -w inventory-web run dev",
    "dev:support": "npm -w support-console run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "~5.5.4"
  }
}
