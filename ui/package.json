{
  "name": "impilo-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Impilo vNext — Frontend workspace root",
  "workspaces": [
    "shared-ui",
    "one-ui-shell",
    "ops-console",
    "ehr",
    "portal"
  ],
  "scripts": {
    "dev:shell": "npm -w one-ui-shell run dev",
    "dev:ops": "npm -w ops-console run dev",
    "dev:ehr": "npm -w ehr run dev",
    "dev:portal": "npm -w portal run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "~5.5.4"
  }
}
