{
  "_comment_ignorePatterns": "Codex-owned paths excluded until Codex runs its own lint pass. Remove after Codex cleanup. Added 2026-04-10 in commit 114e460.",
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "prefer-const": "error",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out"
  ],
  "overrides": [
    {
      "files": [
        "src/components/ehr/**",
        "src/components/clinical/**",
        "src/engines/**",
        "src/data/clerkingTemplates.ts"
      ],
      "rules": {
        "@typescript-eslint/no-unused-vars": "off",
        "no-unused-vars": "off",
        "@typescript-eslint/no-explicit-any": "off",
        "react-hooks/rules-of-hooks": "warn",
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ]
}
