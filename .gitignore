# ===== Vendored Maven repo (populated per-machine, not committed) =====
vendor/m2/repository/*
!vendor/m2/repository/.gitkeep

# ===== Local Nexus data =====
tools/maven/nexus/data/

# ===== Local Maven artifacts =====
.m2/
.m2repo/
services/.m2/
services/.m2repo/
services/.mvn/

# Stray local web workspace copy (canonical UI is ui/one-ui-shell)
apps/web/

# Expo local state (machine-specific, should not be committed)
.expo/
apps/mobile/**/dist/

# Maestro mobile runtime artifacts (APKs, screenshots — not committed)
reports/mobile/artifacts/
*.apk

# Maestro runtime transient logs/markers (formal .md blocker reports ARE committed)
reports/mobile/direct-emulator-*.log
reports/mobile/maestro-runtime-phase.log
reports/mobile/emulator-boot.log
reports/mobile/emulator-boot.pid
reports/mobile/*.pid
reports/mobile/nohup.out
reports/mobile/maestro-runtime-run.marker
reports/mobile/systemd/
reports/mobile/*.service
reports/mobile/citizen-runtime-run.log
reports/mobile/provider-runtime-run.log
reports/mobile/maestro-flows.log
reports/mobile/*-assembleDebug.log
reports/mobile/adb-devices.txt
reports/mobile/android-release.txt
!reports/mobile/android-emulator-sandbox-provisioning-blocker-*.md

# Pipeline run reports (generated on VM; not committed)
reports/pipeline/*.md
reports/pipeline/*.json
!reports/pipeline/.gitkeep
# Change absorption run reports (generated; templates committed)
reports/absorption/latest-*.md
reports/absorption/latest-*.json
reports/absorption/touched-areas.json
!reports/absorption/.gitkeep
!reports/absorption/*.template.*
# Full-boot generated reports (summaries committed; logs stay local)
reports/full-boot/build-logs/
reports/full-boot/image-logs/
reports/full-boot/local-registry-data/
!reports/full-boot/*.md
!reports/full-boot/*.json
!reports/full-boot/*.txt
!reports/full-boot/*.yaml

# Claude Code local worktrees (never commit)
.claude/worktrees/
vendor/models/

# Mobile build artifacts (APKs, screenshots, logs) — regenerated per commit
artifacts/

# Build-id stamp left by some image/build helpers under a service dir. Not source;
# it has already skewed incremental rebuild calculations (see
# docs/runbooks/deploy-optimization-program.md).
**/id_file
services/oros-service/id_file
