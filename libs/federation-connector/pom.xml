<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>zw.gov.mohcc.impilo</groupId>
        <artifactId>impilo-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../services/pom.xml</relativePath>
    </parent>

    <artifactId>federation-connector</artifactId>
    <packaging>jar</packaging>
    <name>Impilo — Federation Connector</name>
    <description>
        Pod-to-spine federation connector: mTLS identity verification interfaces,
        national spine client utilities with mandatory header propagation,
        and FEDERATION_AUTHORITY_VIOLATION conflict handling.
    </description>

    <dependencies>
        <dependency>
            <groupId>zw.gov.mohcc.impilo</groupId>
            <artifactId>tech-companion</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Spring Web (optional — for RestTemplate/WebClient helpers) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Servlet API (provided) -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
