{
  "standard": "FENTON_2013",
  "label": "Fenton 2013 Preterm Growth Chart",
  "axis": "postmenstrual_weeks",
  "postmenstrual_weeks": {
    "min": 22,
    "max": 49
  },
  "content_version": "fenton-2013-bulk-calculator-v6",
  "approval_status": "ENGINEERING_SEED",
  "approval_note": "Pending ratification by the Ministry of Health and Child Care. Ratification must cover both the clinical adoption of this reference for Zimbabwe and the licence determinations recorded below.",
  "source": "University of Calgary, 'Bulk calculator wt hc l - Fenton 2013 growth chart - SD23 - v6' (ucalgary.ca/fenton). Values transcribed verbatim from the published weekly LMS tables; independently corroborated against the authors' exact-age calculator (v7), which agrees to within 1.4e-4 relative.",
  "citation": "Fenton TR, Kim JH. A systematic review and meta-analysis to revise the Fenton growth chart for preterm infants. BMC Pediatr. 2013;13:59.",
  "licence": {
    "identifier": "CC BY-NC-ND 4.0",
    "url": "https://creativecommons.org/licenses/by-nc-nd/4.0/",
    "required_chart_label": "Fenton 2013 Preterm Growth Chart",
    "obligations": [
      "Any chart drawn from this data must display the label 'Fenton 2013 Preterm Growth Chart' conspicuously.",
      "The development paper must be cited wherever this data informs published work.",
      "NonCommercial and NoDerivatives terms apply. Values are stored exactly as published: no smoothing, no re-fitting and no interpolation between the published weekly points."
    ],
    "open_determinations": [
      "Whether a national public health service deployment satisfies the NonCommercial term.",
      "Whether embedding the published weekly values verbatim for lookup is use rather than a derivative work.",
      "The publishers direct data requests to tfenton@ucalgary.ca; public availability of the file is not by itself a licence to embed it."
    ]
  },
  "coverage_notes": [
    "The published tables end at completed week 49. A preterm infant beyond 49 completed weeks postmenstrual age is followed on the WHO 2006 standard at corrected age, which is the transition the chart is drawn for.",
    "Length and head circumference have no published values at 22 weeks: the source states 'Data not available for length and head circumference of infants at 22 weeks gestation'. Those two points are absent here rather than filled in.",
    "Weight uses the WHO SD23 correction beyond three standard deviations, as the publishers' own calculator does. Length and head circumference are normally distributed throughout these charts and take no correction."
  ],
  "units": {
    "weight_for_age": "g",
    "length_height_for_age": "cm",
    "head_circumference_for_age": "cm"
  },
