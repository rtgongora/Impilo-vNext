<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>zw.gov.mohcc.impilo</groupId>
    <artifactId>emergency-domain</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Impilo — Emergency Domain (WHO Interagency Integrated Triage Tool)</name>
    <description>
        Pure Java 21 emergency primitives shared by the clinical plane: the WHO/ICRC/MSF Interagency
        Integrated Triage Tool for age 12-and-over and age under-12, in three-valued logic so an
        unassessed patient is never scored as a well one.

        Transcribed from the vendored, hashed charts in docs/reference/who-emergency-care-toolkit/
        and verified against the pdftotext extractions committed beside them. Those charts carry no
        version number, so the SHA-256 recorded there is the version identity.

        No Spring, no I/O, so the same engine runs inside a service, a batch job or an offline
        package. It owns the published criteria, never national policy: time targets, zone maps and
        destination rules are content, because the IITT FAQ is explicit that time-to-care per colour
        is for facilities to determine.

        The paediatric-domain dependency was removed in W16a: age banding for IITT lives in this
        module's own PaediatricVitalBand, and paediatric-domain contributed only Jackson and
        getResourceAsStream — both hostile to a browser compile and unused by any import here.
    </description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.3</junit.version>
        <!-- W16a spike: pin explicitly so a go/no-go is about this version, not a floating latest. -->
        <teavm.version>0.11.0</teavm.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Provided by TeaVM at browser-compile time; not needed on the JVM runtime path. -->
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-core</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-classlib</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.teavm</groupId>
            <artifactId>teavm-jso-apis</artifactId>
            <version>${teavm.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
        </plugins>
    </build>

    <!--
      Activated explicitly: mvn -Pteavm-spike package
      Keeps the default JVM build free of a TeaVM download on every CI pass; the spike is a
      deliberate go/no-go, not a standing compile cost.
    -->
    <profiles>
        <profile>
            <id>teavm-spike</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.teavm</groupId>
                        <artifactId>teavm-maven-plugin</artifactId>
                        <version>${teavm.version}</version>
                        <executions>
                            <execution>
                                <id>teavm-iitt-corpus</id>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <phase>package</phase>
                                <configuration>
                                    <mainClass>zw.gov.mohcc.impilo.emergency.triage.corpus.IittBrowserCorpusMain</mainClass>
                                    <mainPageIncluded>true</mainPageIncluded>
                                    <targetDirectory>${project.build.directory}/teavm</targetDirectory>
                                    <targetFileName>iitt-corpus.js</targetFileName>
                                    <optimizationLevel>ADVANCED</optimizationLevel>
                                    <!--
                                      Corpus embedding is declared by IittCorpusResourceSupplier
                                      (META-INF/services/org.teavm.classlib.ResourceSupplier), not
                                      by hardcoding the path in callers. ServiceLoader discovers it
                                      during this compile goal.
                                    -->
                                </configuration>
                            </execution>
                            <execution>
                                <id>teavm-iitt-engine</id>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <phase>package</phase>
                                <configuration>
                                    <mainClass>zw.gov.mohcc.impilo.emergency.triage.browser.IittBrowserEvaluateMain</mainClass>
                                    <mainPageIncluded>false</mainPageIncluded>
                                    <targetDirectory>${project.build.directory}/teavm</targetDirectory>
                                    <targetFileName>iitt-engine.js</targetFileName>
                                    <optimizationLevel>ADVANCED</optimizationLevel>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>copy-teavm-harness</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/teavm</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.basedir}/src/teavm</directory>
                                            <includes>
                                                <include>iitt-corpus.html</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
