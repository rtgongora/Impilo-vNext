{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://impilo.gov.zw/schemas/health-os/webhook-subscription.schema.json",
  "title": "Webhook Subscription",
  "description": "Per-external-app webhook delivery subscription managed by the Integration Service. See doctrine §6.",
  "type": "object",
  "required": [
    "externalAppId", "integrationContractId", "eventTopics",
    "deliveryUrl", "signatureMethod", "active", "retryPolicy", "deadLetterAfterRetries"
  ],
  "properties": {
    "externalAppId": { "type": "string" },
    "integrationContractId": { "type": "string" },
    "eventTopics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "deliveryUrl": { "type": "string", "format": "uri" },
    "signatureMethod": { "enum": ["HMAC_SHA256", "ED25519", "NONE_SANDBOX_ONLY"] },
    "active": { "type": "boolean" },
    "filter": {
      "type": "object",
      "properties": {
        "facilityIds": { "type": "array", "items": { "type": "string" } },
        "programmeIds": { "type": "array", "items": { "type": "string" } },
        "extra": { "type": "object" }
      }
    },
    "retryPolicy": {
      "type": "object",
      "required": ["maxRetries", "initialDelayMs", "maxDelayMs"],
      "properties": {
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 20 },
        "initialDelayMs": { "type": "integer", "minimum": 100 },
        "maxDelayMs": { "type": "integer", "minimum": 1000 }
      }
    },
    "deadLetterAfterRetries": { "type": "integer", "minimum": 0 }
  }
}
