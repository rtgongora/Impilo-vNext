  "screenShareRoles": ["PROVIDER", "SUPERVISOR"],
  "resourceSharing": true,
  "auditDepth": "CLINICAL",
  "telemetry": { "participantStats": true, "qualityEvents": true },
  "postSessionActions": ["BILLING_ENRICH", "SUMMARY", "FOLLOW_UP"],
  "khulumaNotificationKeys": [
    "rtc.telemedicine.patient-waiting",
    "rtc.telemedicine.session-ready",
    "rtc.telemedicine.appointment-reminder"
  ],
  "mobileParity": "FULL",
  "fallbackRules": { "audioFirstAllowed": true, "reconnectGraceSeconds": 120, "sipFallback": false },
  "completionCriteriaRef": null
}
