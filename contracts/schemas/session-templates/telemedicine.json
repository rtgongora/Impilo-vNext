{
  "sessionMode": "TELEMEDICINE",
  "owningService": "PCT",
  "liveModes": ["CLINICAL_SESSION"],
  "roles": {
    "PROVIDER": { "canPublish": true, "canSubscribe": true, "canPublishData": true, "roomAdmin": true },
    "PATIENT": { "canPublish": true, "canSubscribe": true, "canPublishData": true },
    "CAREGIVER": { "canPublish": true, "canSubscribe": true, "canPublishData": true },
    "INTERPRETER": { "canPublish": true, "canSubscribe": true, "canPublishData": true, "audioOnlyDefault": true },
    "SUPERVISOR": { "canPublish": true, "canSubscribe": true, "canPublishData": true },
    "OBSERVER": { "canPublish": false, "canSubscribe": true, "canPublishData": false, "hidden": true }
  },
  "defaultLayout": "consult",
  "joinFlow": "LOBBY",
  "lobbyBehaviour": "WAITING_ROOM",
  "tokenTtlSeconds": 3600,
  "maxParticipants": 8,
  "roomPrefix": "impilo-telemedicine",
  "recording": {
    "defaultOn": false,
    "whoCanStart": ["PROVIDER"],
    "consentRequired": true,
