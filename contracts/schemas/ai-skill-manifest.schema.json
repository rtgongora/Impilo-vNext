{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://impilo.health.gov.zw/schemas/ai-skill-manifest.schema.json",
  "title": "AISkillManifest",
  "description": "Manifest for an installable Nompilo AI skill governed through the Health OS Capability Marketplace (Msika Apps).",
  "type": "object",
  "required": [
    "itemCode",
    "name",
    "version",
    "description",
    "publisherId",
    "defaultVisibility",
    "rolesAllowed",
    "tools",
    "permittedPurposesOfUse",
    "tshepoPolicyRef",
    "prohibitedAutonomousActions",
    "supportContact"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "itemCode": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[A-Za-z0-9.-]+)?$" },
    "description": { "type": "string", "minLength": 10 },
    "publisherId": { "type": "string", "minLength": 1 },
    "defaultVisibility": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "MOHCC_ONLY",
        "FACILITY_ONLY",
        "PROGRAMME_ONLY",
        "PROVINCE_ONLY",
        "DISTRICT_ONLY",
        "PRIVATE_SECTOR_ONLY",
        "SANDBOX_ONLY",
        "DEVELOPER_PREVIEW",
        "DEPRECATED",
        "SUSPENDED"
      ]
    },
    "rolesAllowed": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "permittedPurposesOfUse": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "tshepoPolicyRef": { "type": "string", "minLength": 1 },
    "phiAccess": { "type": "boolean", "default": false },
    "safetyDoctrineRef": { "type": "string" },
    "prohibitedAutonomousActions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "documentationUrl": { "type": "string", "format": "uri-reference" },
    "supportContact": {
      "type": "object",
      "required": ["email"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "description", "effect", "requiredScopes", "rolesAllowed", "implementedBy"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]+$" },
          "description": { "type": "string", "minLength": 10 },
          "effect": {
            "type": "string",
            "enum": ["READ_ONLY", "WRITE_LOW_RISK", "WRITE_HIGH_RISK", "INVOKE_EXTERNAL"]
          },
          "requiredScopes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "rolesAllowed": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          "requiresConfirmation": { "type": "boolean" },
          "implementedBy": {
            "type": "object",
            "required": ["serviceId", "className", "methodName"],
            "additionalProperties": false,
            "properties": {
              "serviceId": { "type": "string", "minLength": 1 },
              "className": { "type": "string", "minLength": 1 },
              "methodName": { "type": "string", "minLength": 1 }
            }
          },
          "inputSchemaRef": { "type": "string" },
          "outputSchemaRef": { "type": "string" }
        }
      }
    }
  }
}
