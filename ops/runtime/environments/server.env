# =============================================================================
# Impilo vNext — Server Deployment Environment Profile
# =============================================================================
#
# Profile for deploying to 197.221.242.150 (or any remote server).
# Same services as dev-lite but with production-appropriate credentials.
#
# Usage:
#   cp ops/runtime/environments/server.env ops/runtime/environments/pilot.env
#   # or use directly:
#   source ops/runtime/environments/server.env
#
# =============================================================================

IMPILO_PROFILE=server

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=impilo
POSTGRES_PASSWORD=Imp1l0-vNxt-2026!

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=impilo
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=Imp1l0-KC-Adm1n!
KEYCLOAK_CLIENT_ID=impilo-ui
KEYCLOAK_CLIENT_SECRET=impilo-vnext-client-2026

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=impilominioadmin
MINIO_SECRET_KEY=Imp1l0-M1n10-2026!
MINIO_BUCKET=impilo-docs

# --- HAPI FHIR ---
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir

# --- TSHEPO ---
TSHEPO_URL=http://tshepo:8081
TSHEPO_PEPPER=Imp1l0-TSH3P0-P3PP3R-2026

# --- Envoy ---
ENVOY_ADMIN_PORT=9901

# --- OAuth2 (disabled for initial deployment) ---
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.autoconfigure.security.oauth2.resource.servlet.OAuth2ResourceServerAutoConfiguration

# --- Compose layers to start ---
COMPOSE_PROFILES=infra,shared,edge,ring0,ring1,ring2-lite,app-lite
