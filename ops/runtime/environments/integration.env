# =============================================================================
# Impilo vNext — integration Environment Profile
# =============================================================================
#
# Full platform + observability stack for integration testing.
# Includes all services from dev-full plus Prometheus, Grafana, OTel, Jaeger.
#
# Use this for:
#   - Cross-service integration testing
#   - Steel thread verification
#   - End-to-end flow validation
#   - Observability verification
#
# Services included: ALL layers 0–8
# =============================================================================

IMPILO_PROFILE=integration

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=impilo
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=impilo
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=impilo-ui
KEYCLOAK_CLIENT_SECRET=changeme

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=impilo-docs

# --- HAPI FHIR ---
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir

# --- Orthanc ---
ORTHANC_URL=http://orthanc:8042

# --- TSHEPO ---
TSHEPO_URL=http://tshepo:8081
TSHEPO_PEPPER=integration-pepper-not-for-production

# --- Envoy ---
ENVOY_ADMIN_PORT=9901

# --- OAuth2 (enabled for integration) ---
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://keycloak:8080/realms/impilo
SPRING_AUTOCONFIGURE_EXCLUDE=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=impilo-platform
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Compose layers to start ---
COMPOSE_PROFILES=infra,shared,edge,ring0,ring1,ring2,operations,apps,observability
