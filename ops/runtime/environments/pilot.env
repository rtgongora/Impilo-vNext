# =============================================================================
# Impilo vNext — pilot Environment Profile
# =============================================================================
#
# Production-like profile for pilot deployments and final acceptance testing.
# All services, all layers, OAuth2 enabled, production-grade settings.
#
# Differences from integration:
#   - OAuth2 resource server JWT validation enabled
#   - Stricter security settings
#   - Production-like credentials (change before real deployment)
#   - All services running
#
# IMPORTANT: Change all default passwords before any real pilot deployment.
# =============================================================================

IMPILO_PROFILE=pilot

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=impilo
POSTGRES_PASSWORD=CHANGE_ME_FOR_PILOT

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=impilo
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_FOR_PILOT
KEYCLOAK_CLIENT_ID=impilo-ui
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_FOR_PILOT

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_FOR_PILOT
MINIO_SECRET_KEY=CHANGE_ME_FOR_PILOT
MINIO_BUCKET=impilo-docs

# --- HAPI FHIR ---
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir

# --- Orthanc ---
ORTHANC_URL=http://orthanc:8042

# --- TSHEPO ---
TSHEPO_URL=http://tshepo:8081
TSHEPO_PEPPER=CHANGE_ME_FOR_PILOT_GENERATE_REAL_PEPPER

# --- Envoy ---
ENVOY_ADMIN_PORT=9901

# --- OAuth2 (enabled for pilot) ---
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://keycloak:8080/realms/impilo
SPRING_AUTOCONFIGURE_EXCLUDE=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=impilo-platform
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces

# --- Compose layers to start ---
COMPOSE_PROFILES=infra,shared,edge,ring0,ring1,ring2,operations,apps,observability
