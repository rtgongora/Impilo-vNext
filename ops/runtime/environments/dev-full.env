# =============================================================================
# Impilo vNext — dev-full Environment Profile
# =============================================================================
#
# Full local development profile. Starts all platform services layers 0–7.
# Does NOT include observability stack (use integration profile for that).
#
# Services included:
#   Layer 0 (infra):       postgres, redis, kafka, minio
#   Layer 1 (shared):      keycloak, hapi-fhir, orthanc
#   Layer 2 (edge):        opa, envoy
#   Layer 3 (ring0):       tshepo (+ decomposition services)
#   Layer 4 (ring1):       vito, varapi, tuso, zibo, indawo
#   Layer 5 (ring2):       pct, oros, ubomi, pharmacy, inventory, msika,
#                          msika-flow, mushex, costing-engine, coverage,
#                          inpatient, butano, document, landela, etc.
#   Layer 6 (operations):  integration-hub, notification, jobs, workflow,
#                          channels, forms, search, dispatch, rules,
#                          support, developer-portal, reporting
#   Layer 7 (apps):        experience-bff, one-ui-shell, ops-console, ehr, etc.
#
# Services excluded:
#   - Observability stack (Layer 8)
#   - Data warehouse / analytics services
#   - Surveillance / campaigns
# =============================================================================

IMPILO_PROFILE=dev-full

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=impilo
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=impilo
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Experience BFF (Gap-2: sovereign delegates vs stubs) ---
IMPILO_BFF_CITIZEN_LONGTAIL_MODE=live
IMPILO_BFF_CITIZEN_LONGTAIL_FAILURE_POLICY=stub_fallback
IMPILO_BFF_PROVIDER_HUBS_MODE=live
IMPILO_BFF_PROVIDER_HUBS_FAILURE_POLICY=stub_fallback
IMPILO_BFF_FACILITIES_MODE=live

# --- Auth Fallback (dev only) ---
AUTH_FALLBACK_ENABLED=true
KEYCLOAK_CLIENT_ID=impilo-ui
KEYCLOAK_CLIENT_SECRET=changeme

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=impilo-docs

# --- HAPI FHIR ---
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir

# --- Orthanc ---
ORTHANC_URL=http://orthanc:8042

# --- TSHEPO ---
TSHEPO_URL=http://tshepo:8081
TSHEPO_PEPPER=dev-pepper-not-for-production

# --- Envoy ---
ENVOY_ADMIN_PORT=9901

# --- OAuth2 (disabled for dev) ---
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.autoconfigure.security.oauth2.resource.servlet.OAuth2ResourceServerAutoConfiguration

# --- Compose layers to start ---
COMPOSE_PROFILES=infra,shared,edge,ring0,ring1,ring2,operations,apps
