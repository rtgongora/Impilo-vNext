# =============================================================================
# Impilo vNext — dev-lite Environment Profile
# =============================================================================
#
# Minimal profile for local development and basic testing.
# Starts: infra + shared + edge + Ring 0 (TSHEPO) + Ring 1 (registries)
#         + PCT + OROS + Experience BFF + Experience UI
#
# Use this when you need a working platform with core services but don't
# need the full fleet of clinical, supply chain, or operational services.
#
# Services included:
#   Layer 0 (infra):   postgres, redis, kafka, minio
#   Layer 1 (shared):  keycloak, hapi-fhir
#   Layer 2 (edge):    opa, envoy
#   Layer 3 (ring0):   tshepo
#   Layer 4 (ring1):   vito, varapi, tuso, zibo
#   Layer 5 (ring2):   pct, oros (subset)
#   Layer 7 (app):     experience-bff, experience-ui
#
# Services excluded:
#   - All TSHEPO decomposition services (use monolith tshepo)
#   - Orthanc PACS
#   - Clinical services (ubomi, inpatient, butano, pharmacy)
#   - Supply chain services (msika, msika-flow, inventory)
#   - Finance services (mushex, costing-engine, coverage)
#   - All operations services (integration-hub, notifications, etc.)
#   - All additional UIs (ops-console, ehr, support-console, etc.)
#   - Observability stack (prometheus, grafana, jaeger)
# =============================================================================

IMPILO_PROFILE=dev-lite

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=impilo
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=impilo
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=impilo-ui
KEYCLOAK_CLIENT_SECRET=changeme

# --- MinIO ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=impilo-docs

# --- HAPI FHIR ---
HAPI_FHIR_URL=http://hapi-fhir:8080/fhir

# --- TSHEPO ---
TSHEPO_URL=http://tshepo:8081
TSHEPO_PEPPER=dev-pepper-not-for-production

# --- Envoy ---
ENVOY_ADMIN_PORT=9901

# --- OAuth2 (disabled for dev) ---
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=
SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.autoconfigure.security.oauth2.resource.servlet.OAuth2ResourceServerAutoConfiguration

# --- Auth Fallback (dev only) ---
AUTH_FALLBACK_ENABLED=true

# --- Compose layers to start ---
COMPOSE_PROFILES=infra,shared,edge,ring0,ring1,ring2-lite,app-lite
